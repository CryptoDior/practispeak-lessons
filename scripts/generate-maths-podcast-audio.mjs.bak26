    { n: 54, afterSeg:  66, title: `COMPARE`, onScreen: `x < −8 or x > 1 two pieces need the word or · 1 < x < −8 nonsense — no number is both` },
    { n: 55, afterSeg:  68, title: `LEARNERS WRITE IT EVERY YEAR`, onScreen: `the word or is doing real work` },
    { n: 56, afterSeg:  69, title: `NSC PAPER 1 • NOVEMBER 2014`, onScreen: `NSC Mathematics P1 · November 2014 · Question 1.3 · 4 marks` },
    { n: 57, afterSeg:  71, title: `QUESTION 1.3`, onScreen: `(x − 1)(x − 2) < 6 · Solve for x.` },
    { n: 58, afterSeg:  72, title: `TYLA READS THE BRACKETS OFF`, onScreen: `red · critical values 1 and 2 ✗` },
    { n: 59, afterSeg:  73, title: `THE MOST EXPENSIVE MISTAKE IN THIS TOPIC`, onScreen: `and it looks completely reasonable` },
    { n: 60, afterSeg:  75, title: `IT IS NOT AGAINST ZERO. IT IS AGAINST SIX.`, onScreen: `and that changes everything` },
    { n: 61, afterSeg:  76, title: `COMPARE`, onScreen: `= 0 one bracket must be 0 · = 6 2 and 3? 1 and 6? 12 and a half?` },
    { n: 62, afterSeg:  78, title: `SIX TRAPS NOTHING`, onScreen: `so the brackets are useless while the six is sitting there` },
    { n: 63, afterSeg:  80, title: `SO EXPAND, AND START AGAIN PROPERLY`, onScreen: `step one was never optional` },
    { n: 64, afterSeg:  81, title: `EXPAND IT`, onScreen: `(−1) × x = −x` },
    { n: 65, afterSeg:  82, title: `AND THE LAST PAIR`, onScreen: `(−1)(−2) = +2` },
    { n: 66, afterSeg:  83, title: `COLLECT THE MIDDLE`, onScreen: `x² − 3x + 2 < 6` },
    { n: 67, afterSeg:  85, title: `NOW STEP ONE — MAKE ONE SIDE ZERO`, onScreen: `the same first move, every single time` },
    { n: 68, afterSeg:  86, title: `TAKE THE SIX ACROSS`, onScreen: `x² − 3x − 4 < 0` },
    { n: 69, afterSeg:  88, title: `TWO NUMBERS`, onScreen: `−4 and 1` },
    { n: 70, afterSeg:  89, title: `SO IT FACTORISES AS`, onScreen: `(x + 1)(x − 4) < 0` },
    { n: 71, afterSeg:  91, title: `COMPARE`, onScreen: `1 and 2 what the brackets seemed to say · −1 and 4 the real critical values` },
    { n: 72, afterSeg:  92, title: `THAT IS WHAT THE EXPANDING WAS FOR`, onScreen: `Nothing like the numbers you could read off the page.` },
    { n: 73, afterSeg:  93, title: `TEST ZERO`, onScreen: `= −4 · negative ✓` },
    { n: 74, afterSeg:  94, title: `LESS THAN ZERO — THE MIDDLE`, onScreen: `−1 < x < 4 (boxed)` },
    { n: 75, afterSeg:  95, title: `THE MEMORANDUM ANSWER, WORD FOR WORD`, onScreen: `−1 < x < 4, or x ∈ (−1 ; 4).` },
    { n: 76, afterSeg:  96, title: `EXAMPLE 3`, onScreen: `x² > 9 · answer it the way it feels natural` },
    { n: 77, afterSeg:  98, title: `TYLA SQUARE ROOTS BOTH SIDES`, onScreen: `red · x > 3` },
    { n: 78, afterSeg:  99, title: `TEST A NUMBER. TRY NEGATIVE FIVE.`, onScreen: `one substitution is all it takes` },
    { n: 79, afterSeg: 100, title: `BUT NEGATIVE FIVE WORKS`, onScreen: `red · and −5 is not > 3` },
    { n: 80, afterSeg: 102, title: `NEVER SQUARE ROOT AN INEQUALITY`, onScreen: `you throw away the whole negative half` },
    { n: 81, afterSeg: 104, title: `BACK TO THE FOUR STEPS`, onScreen: `Make one side zero first. The method never changes.` },
    { n: 82, afterSeg: 105, title: `MAKE ONE SIDE ZERO`, onScreen: `x² − 9 > 0` },
    { n: 83, afterSeg: 106, title: `DIFFERENCE OF SQUARES — EPISODE 2`, onScreen: `(x − 3)(x + 3) > 0` },
    { n: 84, afterSeg: 107, title: `THE CRITICAL VALUES`, onScreen: `x = 3 or x = −3` },
    { n: 85, afterSeg: 109, title: `GREATER THAN ZERO — OUTSIDE`, onScreen: `x < −3 or x > 3 (boxed)` },
    { n: 86, afterSeg: 110, title: `AND NOW NEGATIVE FIVE IS INCLUDED`, onScreen: `it fits, exactly as it should ✓ (boxed)` },
    { n: 87, afterSeg: 112, title: `ONE QUESTION, TWO PIECES, AND THE WORD OR`, onScreen: `holding them together` },
    { n: 88, afterSeg: 113, title: `WHERE YOU LOSE MARKS`, onScreen: `WHERE YOU LOSE MARKS` },
    { n: 89, afterSeg: 114, title: `POINT 1 • MAKE ONE SIDE ZERO FIRST`, onScreen: `Make one side zero first — factors only mean something against zero` },
    { n: 90, afterSeg: 115, title: `POINT 2 • CRITICAL VALUES ARE NOT THE ANSWER`, onScreen: `Critical values are not the answer — they are the fence posts — you still have to say which side` },
    { n: 91, afterSeg: 116, title: `POINT 3 • NEVER SQUARE ROOT AN INEQUALITY`, onScreen: `Never square root an inequality — you lose the negative half every time` },
    { n: 92, afterSeg: 117, title: `REMEMBER`, onScreen: `REMEMBER` },
    { n: 93, afterSeg: 118, title: `POINT 1 • LESS THAN IS IN, GREATER THAN IS OUT`, onScreen: `Less than is in, greater than is out — and two outside pieces are joined by or` },
    { n: 94, afterSeg: 119, title: `POINT 2 • TEST A NUMBER`, onScreen: `Test a number — one substitution settles it in five seconds` },
    { n: 95, afterSeg: 120, title: `YOUR TURN`, onScreen: `x² − x − 6 ≥ 0 · solve for x` },
    { n: 96, afterSeg: 121, title: `PAUSE AND TRY`, onScreen: `PAUSE AND TRY` },
    { n: 97, afterSeg: 122, title: `WATCH THAT SIGN`, onScreen: `Greater than or equal to. The circles close, and the critical values are part of the answer.` },
