    { n: 18, afterSeg: 30, title: `NSC PAPER 1 • NOVEMBER 2014`, onScreen: `NSC Mathematics P1 · November 2014 · Question 2.3` },
    { n: 19, afterSeg: 31, title: `THE QUESTION • SIGMA NOTATION`, onScreen: `2.3 Express the series in sigma notation. (2)` },
    { n: 20, afterSeg: 34, title: `WE ALREADY HAVE THE RULE`, onScreen: `from Episode 1: Tₙ = 7n − 5` },
