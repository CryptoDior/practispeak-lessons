    { n: 50, afterSeg:  64, title: `NOW THE ASYMPTOTE`, onScreen: `3 × 2x > 0` },
    { n: 51, afterSeg:  66, title: `AND THEN MINUS SIX`, onScreen: `never equal to it` },
    { n: 52, afterSeg:  67, title: `THE ASYMPTOTE IS Y = −6`, onScreen: `f(x) = 3 × 2x − 6 · asymptotes y = −6` },
    { n: 53, afterSeg:  68, title: `SO THE RANGE IS`, onScreen: `y > −6 ✓ (boxed)` },
