    { n:  5, afterSeg:   6, title: `WRITE IT OUT`, onScreen: `(x − 3)(x + 2) ≥ 0` },
    { n:  6, afterSeg:   8, title: `THE CRITICAL VALUES`, onScreen: `3 and −2` },
    { n:  7, afterSeg:   9, title: `GREATER THAN ZERO — SO WHICH SIDE?`, onScreen: `NUMBER LINE` },
    { n:  8, afterSeg:  10, title: `OUTSIDE — AND THE CIRCLES CLOSE`, onScreen: `OUTSIDE THE CRITICAL VALUES` },
    { n:  9, afterSeg:  11, title: `AN EQUAL TO IN THE SIGN`, onScreen: `The circles close, and the critical values themselves are part of the answer.` },
    { n: 10, afterSeg:  12, title: `SO WRITE IT PROPERLY`, onScreen: `x ≤ −2 or x ≥ 3 (boxed)` },
    { n: 11, afterSeg:  14, title: `TEST ZERO, FROM THE MIDDLE`, onScreen: `= −6 · the middle is out ✓ ✓ (boxed)` },
    { n: 12, afterSeg:  15, title: `EXPONENTS`, onScreen: `EXPONENTS` },
    { n: 13, afterSeg:  16, title: `THE SIX LAWS`, onScreen: `THE SIX LAWS` },
    { n: 14, afterSeg:  17, title: `NOT ON THE FORMULA SHEET`, onScreen: `you carry these in your head` },
    { n: 15, afterSeg:  18, title: `LAW 1 · MULTIPLYING`, onScreen: `am × aⁿ = am + ⁿ` },
    { n: 16, afterSeg:  19, title: `LAW 2 · DIVIDING`, onScreen: `(am)/(aⁿ) = am &miⁿus; ⁿ` },
    { n: 17, afterSeg:  20, title: `LAW 3 · A POWER OF A POWER`, onScreen: `(am)ⁿ = amⁿ` },
    { n: 18, afterSeg:  21, title: `LAW 4 · THE ZERO POWER`, onScreen: `a⁰ = 1` },
    { n: 19, afterSeg:  22, title: `LAW 5 · A NEGATIVE EXPONENT`, onScreen: `a&miⁿus;ⁿ = (1)/(aⁿ)` },
    { n: 20, afterSeg:  23, title: `LAW 6 · A FRACTIONAL EXPONENT IS A ROOT`, onScreen: `am/ⁿ = the nth root of am` },
    { n: 21, afterSeg:  24, title: `COMPARE`, onScreen: `x¹/³ the cube root of x · x¹/² the square root of x` },
    { n: 22, afterSeg:  26, title: `AND THIS IS THE WHOLE GAME`, onScreen: `same base → equal exponents` },
    { n: 23, afterSeg:  27, title: `SO`, onScreen: `x = 5 ✓ (boxed)` },
    { n: 24, afterSeg:  28, title: `GET BOTH SIDES ONTO THE SAME BASE`, onScreen: `that is the whole job — everything after it is bookkeeping` },
    { n: 25, afterSeg:  29, title: `NSC PAPER 1 • NOVEMBER 2014`, onScreen: `NSC Mathematics P1 · November 2014 · Question 1.1.3 · 3 marks` },
    { n: 26, afterSeg:  31, title: `QUESTION 1.1.3`, onScreen: `2x + ² + 2x = 20 · Solve for x.` },
    { n: 27, afterSeg:  32, title: `TYLA ADDS THE EXPONENTS`, onScreen: `red · 2²x + ² ✗` },
    { n: 28, afterSeg:  34, title: `TEST IT WITH X = 2`, onScreen: `red · = 64, not 20` },
    { n: 29, afterSeg:  35, title: `ADDING DOES NOTHING TO EXPONENTS`, onScreen: `Exponents add when the powers are multiplied. These two are added.` },
    { n: 30, afterSeg:  37, title: `TAKE OUT A COMMON FACTOR`, onScreen: `Exactly like taking x out of x² + x, back in episode 2.` },
    { n: 31, afterSeg:  38, title: `SPLIT THE AWKWARD ONE`, onScreen: `2x + ² = 2x × 2²` },
    { n: 32, afterSeg:  39, title: `WHY IT COMES APART`, onScreen: `Multiplying adds the exponents — so x + 2 splits back into x and 2.` },
    { n: 33, afterSeg:  40, title: `SO THE LEFT SIDE IS NOW`, onScreen: `2² × 2x + 2x` },
    { n: 34, afterSeg:  41, title: `BOTH TERMS CARRY IT`, onScreen: `4 × 2x + 1 × 2x` },
    { n: 35, afterSeg:  42, title: `SO TAKE IT OUT THE FRONT`, onScreen: `the same move as any other common factor` },
    { n: 36, afterSeg:  43, title: `TAKE OUT THE COMMON POWER`, onScreen: `5 × 2x = 20` },
    { n: 37, afterSeg:  44, title: `THAT LINE IS A MARK ON ITS OWN`, onScreen: `The marking guideline gives one just for the common factor.` },
    { n: 38, afterSeg:  45, title: `DIVIDE BY THE FIVE`, onScreen: `2x = 4` },
    { n: 39, afterSeg:  47, title: `REWRITE 4 AS A POWER OF 2`, onScreen: `x = 2 ✓ (boxed)` },
    { n: 40, afterSeg:  48, title: `CHECK IT`, onScreen: `16 + 4 = 20 ✓ ✓ (boxed)` },
    { n: 41, afterSeg:  49, title: `NSC PAPER 1 • NOVEMBER 2015`, onScreen: `NSC Mathematics P1 · November 2015 · Question 1.1.3 · 4 marks (no calculator)` },
    { n: 42, afterSeg:  51, title: `QUESTION 1.1.3`, onScreen: `2x&miⁿus;⁵/³ = 64 · Solve for x, without using a calculator.` },
    { n: 43, afterSeg:  53, title: `COMPARE`, onScreen: `example 1 the letter was in the exponent · example 2 the letter is the base` },
    { n: 44, afterSeg:  55, title: `GET X ON ITS OWN FIRST`, onScreen: `x&miⁿus;⁵/³ = 32` },
    { n: 45, afterSeg:  57, title: `RAISE BOTH SIDES TO THE RECIPROCAL`, onScreen: `x = 32&miⁿus;³/⁵` },
    { n: 46, afterSeg:  59, title: `THAT LOOKS WORSE THAN WHAT WE STARTED WITH`, onScreen: `it is not — and here is why` },
    { n: 47, afterSeg:  60, title: `32 IS A POWER OF 2`, onScreen: `so rewrite it that way` },
    { n: 48, afterSeg:  61, title: `REWRITING A NUMBER AS A POWER IS A MARK`, onScreen: `The guideline gives you one just for spotting it.` },
    { n: 49, afterSeg:  62, title: `SO IT READS`, onScreen: `x = (2⁵)&miⁿus;³/⁵` },
    { n: 50, afterSeg:  63, title: `A POWER OF A POWER — MULTIPLY`, onScreen: `x = 2&miⁿus;³` },
    { n: 51, afterSeg:  65, title: `LAW 5 AGAIN`, onScreen: `a&miⁿus;ⁿ = (1)/(aⁿ)` },
    { n: 52, afterSeg:  66, title: `AND A NEGATIVE EXPONENT FLIPS IT`, onScreen: `x = (1)/(8) or 0,125 ✓ (boxed)` },
    { n: 53, afterSeg:  68, title: `AND NO CALCULATOR ANYWHERE IN THAT`, onScreen: `which is exactly why they chose 32 and 64` },
    { n: 54, afterSeg:  69, title: `LEARN THESE BY HEART`, onScreen: `2¹ to 2⁵ — 2, 4, 8, 16, 32 · 2⁶ to 2¹⁰ — 64, 128, 256, 512, 1 024 · 3¹ to 3⁵ — 3, 9, 27, 81, 243` },
    { n: 55, afterSeg:  70, title: `NSC PAPER 1 • NOVEMBER 2024`, onScreen: `NSC Mathematics P1 · November 2024 · Question 1.1.4 · 5 marks` },
    { n: 56, afterSeg:  72, title: `QUESTION 1.1.4`, onScreen: `2²x − 2x + ² − 32 = 0 · Solve for x.` },
    { n: 57, afterSeg:  73, title: `THREE TERMS, AND IT EQUALS ZERO`, onScreen: `that is the shape of a quadratic` },
    { n: 58, afterSeg:  74, title: `IT IS ONE, IN DISGUISE`, onScreen: `split the middle term first` },
    { n: 59, afterSeg:  75, title: `SPLIT THE MIDDLE TERM`, onScreen: `= 4 × 2x` },
    { n: 60, afterSeg:  77, title: `AND THE FIRST TERM`, onScreen: `2²x = (2x)²` },
    { n: 61, afterSeg:  78, title: `IT IS A QUADRATIC IN DISGUISE`, onScreen: `Treat 2x as one single thing. Then it reads: that thing squared, minus four of it, minus thirty two.` },
    { n: 62, afterSeg:  79, title: `TWO NUMBERS`, onScreen: `−8 and 4` },
    { n: 63, afterSeg:  81, title: `SO WRITE IT OUT`, onScreen: `(2x − 8)(2x + 4) = 0` },
    { n: 64, afterSeg:  83, title: `SPLIT IT`, onScreen: `2x = 8 or 2x = −4` },
    { n: 65, afterSeg:  84, title: `TYLA TAKES THE SECOND ONE TOO`, onScreen: `red · x = −2 ✗` },
    { n: 66, afterSeg:  86, title: `TEST IT`, onScreen: `= (1)/(4)` },
    { n: 67, afterSeg:  87, title: `SMALL, BUT POSITIVE`, onScreen: `which is the whole point` },
    { n: 68, afterSeg:  88, title: `A POWER OF 2 IS ALWAYS POSITIVE`, onScreen: `Always. There is no exponent that turns it negative.` },
    { n: 69, afterSeg:  89, title: `COMPARE`, onScreen: `big exponent big answer · negative exponent small answer — never negative` },
    { n: 70, afterSeg:  91, title: `SO REJECT IT — IN WRITING`, onScreen: `the guideline gives a mark for saying so` },
    { n: 71, afterSeg:  92, title: `EIGHT IS TWO CUBED`, onScreen: `x = 3 ✓ (boxed)` },
    { n: 72, afterSeg:  93, title: `CHECK IT`, onScreen: `64 − 32 − 32 = 0 ✓ ✓ (boxed)` },
    { n: 73, afterSeg:  94, title: `WHERE YOU LOSE MARKS`, onScreen: `WHERE YOU LOSE MARKS` },
    { n: 74, afterSeg:  95, title: `POINT 1 • EXPONENTS ADD ONLY WHEN POWERS MULTIPLY`, onScreen: `Exponents add only when powers multiply — adding two powers does nothing to their exponents` },
    { n: 75, afterSeg:  96, title: `POINT 2 • REWRITE EVERY NUMBER AS A POWER`, onScreen: `Rewrite every number as a power — 32 is 2 to the power of 5 — and that is a mark on its own` },
    { n: 76, afterSeg:  97, title: `POINT 3 • REJECT A NEGATIVE POWER, IN WRITING`, onScreen: `Reject a negative power, in writing — a power of a positive base is never negative` },
    { n: 77, afterSeg:  98, title: `REMEMBER`, onScreen: `REMEMBER` },
    { n: 78, afterSeg:  99, title: `POINT 1 • TAKE OUT THE COMMON POWER`, onScreen: `Take out the common power — the one with the smaller exponent is the one that comes out` },
    { n: 79, afterSeg: 100, title: `POINT 2 • LEARN THE POWERS OF 2 AND 3`, onScreen: `Learn the powers of 2 and 3 — these questions are built on them, and there is no calculator` },
    { n: 80, afterSeg: 101, title: `YOUR TURN`, onScreen: `3x + ¹ − 3x = 54 · solve for x` },
    { n: 81, afterSeg: 102, title: `PAUSE AND TRY`, onScreen: `PAUSE AND TRY` },
    { n: 82, afterSeg: 103, title: `START THE SAME WAY`, onScreen: `Take out the common power. Everything else follows from that one line.` },
    { n: 83, afterSeg: 104, title: `NEXT • SURDS`, onScreen: `NEXT — EPISODE 8: SURDS` },
  ],
},
{
  num: 8,
  series: 'Revision-Part-1',
  file: 'Episode 8 - Surds',
  segs: [
    { s: 'AMELIA',   t: `Episode eight. Surds.` },
    { s: 'MICHAEL',  t: `Last episode was powers. A surd is the same idea, running backwards.` },
    { s: 'TYLA',     t: `Homework first.` },
    { s: 'MICHAEL',  t: `Solve for x. Three to the power of, x plus one, minus three to the power of x, equals fifty four.` },
    { s: 'TYLA',     t: `Take out the common power. Three to the power of, x plus one, is three to the power of x, times three.` },
    { s: 'MICHAEL',  t: `Good. So both terms carry it.` },
    { s: 'TYLA',     t: `Three to the power of x, bracket three minus one. Which is two, times three to the power of x.` },
    { s: 'MICHAEL',  t: `And that is your mark for the common factor.` },
    { s: 'TYLA',     t: `Two times three to the power of x equals fifty four. So three to the power of x is twenty seven.` },
    { s: 'MICHAEL',  t: `Same base.` },
    { s: 'TYLA',     t: `Twenty seven is three cubed. So x is three.` },
    { s: 'MICHAEL',  t: `Check it. Three to the power of four is eighty one. Minus twenty seven. That is fifty four. Correct.` },
    { s: 'MICHAEL',  t: `Now. Surds.` },
    { s: 'TYLA',     t: `What is a surd, exactly?` },
    { s: 'MICHAEL',  t: `A root that does not come out to a whole number. The square root of nine is three, so that one is not a surd.` },
    { s: 'MICHAEL',  t: `But the square root of two is one comma four one four, and it never stops and it never repeats.` },
    { s: 'TYLA',     t: `So you leave it as a root.` },
    { s: 'MICHAEL',  t: `You leave it. In Paper One you are asked for the exact form, which means you do not reach for the calculator.` },
    { s: 'MICHAEL',  t: `Two skills first, quickly. Then three exam questions.` },
    { s: 'MICHAEL',  t: `Skill one. Simplifying a surd. You look for a perfect square hiding inside it.` },
    { s: 'MICHAEL',  t: `Take the square root of fifty. Fifty is twenty five, times two.` },
    { s: 'TYLA',     t: `And twenty five is a perfect square.` },
    { s: 'MICHAEL',  t: `So the square root of fifty is the square root of twenty five, times the square root of two.` },
    { s: 'TYLA',     t: `Which is five, times the square root of two.` },
    { s: 'MICHAEL',  t: `Same number, written properly. But notice what let you do that. The fifty was a multiply.` },
    { s: 'TYLA',     t: `So the square root of, nine plus sixteen, is not three plus four?` },
    { s: 'MICHAEL',  t: `Test it. Nine plus sixteen is twenty five. And the square root of twenty five is five, not seven.` },
    { s: 'TYLA',     t: `So a root does not split across a plus.` },
    { s: 'MICHAEL',  t: `Never. Only across a multiply or a divide. That one costs marks every single year.` },
    { s: 'MICHAEL',  t: `Skill two. Rationalising the denominator. It means clearing the root off the bottom of a fraction.` },
    { s: 'TYLA',     t: `Why does it have to go?` },
    { s: 'MICHAEL',  t: `Convention, mostly. A root on the bottom is treated as unfinished work.` },
    { s: 'MICHAEL',  t: `So take one, divided by the square root of two. Multiply the top and the bottom by the square root of two.` },
    { s: 'TYLA',     t: `That is multiplying by one, so the value cannot change.` },
    { s: 'MICHAEL',  t: `Exactly. And on the bottom, the square root of two times the square root of two is just two.` },
    { s: 'TYLA',     t: `And the top becomes the square root of two.` },
    { s: 'MICHAEL',  t: `So one divided by the square root of two is the same as the square root of two, divided by two.` },
    { s: 'TYLA',     t: `The root moved upstairs.` },
    { s: 'MICHAEL',  t: `That is the whole trick.` },
    { s: 'MICHAEL',  t: `Now the part the exam actually tests. Almost every year, question one has an equation with a root in it.` },
    { s: 'TYLA',     t: `And how do you get rid of a root?` },
    { s: 'MICHAEL',  t: `You square it. But squaring is dangerous, and this is why.` },
    { s: 'MICHAEL',  t: `Five squared is twenty five. And negative five squared is also twenty five.` },
    { s: 'TYLA',     t: `So squaring throws the sign away.` },
    { s: 'MICHAEL',  t: `It does. Which means that when you square an equation, you can create an answer that was never in it.` },
    { s: 'MICHAEL',  t: `And that is why every one of these questions ends with a check. Every time.` },
    { s: 'MICHAEL',  t: `Example one.` },
    { s: 'AMELIA',   t: `National Senior Certificate, Mathematics Paper One, November two thousand and twenty three. Question one point one point three.` },
    { s: 'MICHAEL',  t: `Solve for x. The square root of, two x plus one, equals x minus one. Four marks.` },
    { s: 'TYLA',     t: `The root is already alone on the left.` },
    { s: 'MICHAEL',  t: `So square both sides. The whole side each time, not the pieces.` },
    { s: 'TYLA',     t: `On the left the root disappears, and I am left with two x plus one.` },
    { s: 'TYLA',     t: `And on the right, bracket x minus one, all squared.` },
    { s: 'MICHAEL',  t: `Which is not x squared minus one. Back to episode one.` },
    { s: 'TYLA',     t: `x squared, minus two x, plus one.` },
    { s: 'MICHAEL',  t: `So write the whole equation out.` },
    { s: 'TYLA',     t: `Two x plus one, equals x squared minus two x plus one.` },
    { s: 'MICHAEL',  t: `Make one side zero.` },
    { s: 'TYLA',     t: `The ones cancel. So zero equals x squared minus four x.` },
    { s: 'MICHAEL',  t: `And that has a common factor.` },
    { s: 'TYLA',     t: `x, bracket x minus four, equals zero. So x is zero, or x is four.` },
    { s: 'MICHAEL',  t: `Now check both. Always both.` },
    { s: 'TYLA',     t: `For x equals four. The square root of nine is three. And four minus one is three. That works.` },
    { s: 'TYLA',     t: `For x equals zero. The square root of one is one. But zero minus one is negative one.` },
    { s: 'MICHAEL',  t: `One is not negative one. So zero is not a solution.` },
    { s: 'TYLA',     t: `Even though the algebra handed it to me.` },
    { s: 'MICHAEL',  t: `The squaring handed it to you. The original equation never had it. So the answer is x equals four, on its own.` },
    { s: 'MICHAEL',  t: `Example two. And this is the one to remember, because of what the marking guideline says.` },
    { s: 'AMELIA',   t: `National Senior Certificate, Mathematics Paper One, November two thousand and twenty. Question one point one point four.` },
    { s: 'MICHAEL',  t: `Solve for x. The square root of, x plus eighteen, equals x minus two. Five marks.` },
    { s: 'TYLA',     t: `The root is alone. So I square both sides.` },
    { s: 'TYLA',     t: `x plus eighteen, equals bracket x minus two, all squared.` },
    { s: 'MICHAEL',  t: `Expand it carefully.` },
    { s: 'TYLA',     t: `x squared, minus four x, plus four.` },
    { s: 'MICHAEL',  t: `Make one side zero.` },
    { s: 'TYLA',     t: `Zero equals x squared, minus five x, minus fourteen.` },
    { s: 'MICHAEL',  t: `Factorise.` },
    { s: 'TYLA',     t: `Two numbers that multiply to negative fourteen and add to negative five. Negative seven and two.` },
    { s: 'TYLA',     t: `So bracket x minus seven, bracket x plus two, equals zero. x is seven, or x is negative two.` },
    { s: 'MICHAEL',  t: `Check.` },
    { s: 'TYLA',     t: `For seven. The square root of twenty five is five. And seven minus two is five. That works.` },
    { s: 'TYLA',     t: `For negative two. The square root of sixteen is four. But negative two, minus two, is negative four.` },
    { s: 'MICHAEL',  t: `Four is not negative four. So you reject it.` },
    { s: 'MICHAEL',  t: `And here is why this question matters. Five marks. One for squaring, one for the standard form, one for the factors, one for both answers.` },
    { s: 'MICHAEL',  t: `And the fifth mark is written into the guideline, in words. Rejection of x equals negative two.` },
    { s: 'TYLA',     t: `So they pay you for the rejection.` },
    { s: 'MICHAEL',  t: `They pay you for the rejection. Which means you have to write it down, not simply leave it out.` },
    { s: 'MICHAEL',  t: `Example three. Same topic, one extra step, and a trap right at the start.` },
    { s: 'AMELIA',   t: `National Senior Certificate, Mathematics Paper One, November two thousand and twenty four. Question one point one point five.` },
    { s: 'MICHAEL',  t: `Solve for x. The square root of, negative two x plus four, minus x, equals two. Four marks.` },
    { s: 'TYLA',     t: `I will square both sides. So negative two x plus four, minus x squared, equals four.` },
    { s: 'MICHAEL',  t: `Stop there. What did you actually square?` },
    { s: 'TYLA',     t: `Each piece.` },
    { s: 'MICHAEL',  t: `And you cannot. Squaring a difference is not the same as squaring the two parts. Episode one again.` },
    { s: 'TYLA',     t: `So bracket a minus b, all squared, is not a squared minus b squared.` },
    { s: 'MICHAEL',  t: `It is not. So before you square anything at all, get the root on its own.` },
    { s: 'TYLA',     t: `Add x to both sides. The square root of, negative two x plus four, equals two plus x.` },
    { s: 'MICHAEL',  t: `Now the root is alone, and squaring is safe. And that isolating step is a mark of its own in the guideline.` },
    { s: 'TYLA',     t: `So, negative two x plus four, equals bracket two plus x, all squared. Which is four, plus four x, plus x squared.` },
    { s: 'MICHAEL',  t: `Make one side zero.` },
    { s: 'TYLA',     t: `The fours cancel. So zero equals x squared, plus six x.` },
    { s: 'TYLA',     t: `Which means x, bracket x plus six, equals zero. So x is zero, or x is negative six.` },
    { s: 'MICHAEL',  t: `Check.` },
    { s: 'TYLA',     t: `For zero. The square root of four is two. Minus zero. That is two. It works.` },
    { s: 'TYLA',     t: `For negative six. Negative two times negative six is twelve, plus four is sixteen. And the square root of sixteen is four.` },
    { s: 'TYLA',     t: `And then minus negative six. So four plus six, which is ten.` },
    { s: 'MICHAEL',  t: `Ten is not two. Reject it. So x equals zero, on its own.` },
    { s: 'MICHAEL',  t: `Three things.` },
    { s: 'MICHAEL',  t: `Number one. Get the root on its own before you square. Always, and it is worth a mark.` },
    { s: 'MICHAEL',  t: `Number two. Bracket x minus one, all squared, is not x squared minus one. Expand it properly.` },
    { s: 'MICHAEL',  t: `Number three. Check both answers, and write the rejection down. They pay for it.` },
    { s: 'MICHAEL',  t: `Two things to remember.` },
    { s: 'MICHAEL',  t: `One. Squaring forgets the sign, so it can invent an answer that was never there.` },
    { s: 'MICHAEL',  t: `Two. A root splits across a multiply, never across a plus.` },
    { s: 'MICHAEL',  t: `Here is your question. Solve for x. Three, times the square root of x, equals x minus four.` },
    { s: 'MICHAEL',  t: `Pause and try it. I will wait.`, pause: 3.0 },
    { s: 'TYLA',     t: `Square both sides. And then check both answers, because one of them will not survive.` },
    { s: 'MICHAEL',  t: `Next time, the last one in this series. Episode nine. The nature of roots.` },
  ],
  slides: [
    { n:  1, afterSeg:   0, title: `REVISION 1 • EPISODE 8 • SURDS`, onScreen: `EPISODE 8 — SURDS` },
    { n:  2, afterSeg:   1, title: `A SURD IS A POWER, RUNNING BACKWARDS`, onScreen: `and the exam tests it in exactly one way` },
    { n:  3, afterSeg:   3, title: `YOUR HOMEWORK`, onScreen: `3x + ¹ − 3x = 54 · solve for x` },
    { n:  4, afterSeg:   4, title: `SPLIT THE AWKWARD ONE`, onScreen: `3x + ¹ = 3x × 3` },
    { n:  5, afterSeg:   5, title: `SO BOTH TERMS CARRY IT`, onScreen: `take 3x out the front` },
    { n:  6, afterSeg:   6, title: `THE COMMON POWER`, onScreen: `2 × 3x = 54` },
    { n:  7, afterSeg:   8, title: `DIVIDE BY THE TWO`, onScreen: `3x = 27` },
    { n:  8, afterSeg:  10, title: `27 IS 3 CUBED`, onScreen: `x = 3 ✓ (boxed)` },
    { n:  9, afterSeg:  11, title: `CHECK IT`, onScreen: `81 − 27 = 54 ✓ ✓ (boxed)` },
    { n: 10, afterSeg:  12, title: `SURDS`, onScreen: `SURDS` },
    { n: 11, afterSeg:  14, title: `COMPARE`, onScreen: `9 = 3 exact, and whole — not a surd · 2 never stops, never repeats` },
    { n: 12, afterSeg:  15, title: `THE SQUARE ROOT OF TWO`, onScreen: `it never ends and never repeats` },
    { n: 13, afterSeg:  16, title: `SO YOU LEAVE IT AS A ROOT`, onScreen: `that is what a surd is` },
    { n: 14, afterSeg:  17, title: `EXACT FORM`, onScreen: `do not reach for the calculator` },
    { n: 15, afterSeg:  18, title: `WHAT THIS EPISODE COVERS`, onScreen: `1 simplifying a surd · 2 rationalising the denominator · 3 the equation the exam actually asks` },
    { n: 16, afterSeg:  19, title: `SIMPLIFYING`, onScreen: `SIMPLIFYING` },
    { n: 17, afterSeg:  20, title: `LOOK FOR A PERFECT SQUARE INSIDE`, onScreen: `50 = 25 × 2` },
    { n: 18, afterSeg:  22, title: `SPLIT THE ROOT ACROSS THE MULTIPLY`, onScreen: `25 = 5` },
    { n: 19, afterSeg:  23, title: `SO IT SIMPLIFIES TO`, onScreen: `52 ✓ (boxed)` },
    { n: 20, afterSeg:  24, title: `THAT ONLY WORKED BECAUSE 50 WAS A MULTIPLY`, onScreen: `25 times 2 — not 25 plus 2` },
    { n: 21, afterSeg:  25, title: `SO CAN YOU DO THIS?`, onScreen: `red · = 3 + 4 = 7 ✗` },
    { n: 22, afterSeg:  26, title: `TEST IT`, onScreen: `25 = 5, not 7` },
    { n: 23, afterSeg:  27, title: `COMPARE`, onScreen: `a × b = ab across a multiply — yes · a + b ≠ a + b across a plus — never` },
    { n: 24, afterSeg:  28, title: `A ROOT NEVER SPLITS ACROSS A PLUS`, onScreen: `this one costs marks every year` },
    { n: 25, afterSeg:  29, title: `RATIONALISING`, onScreen: `RATIONALISING` },
    { n: 26, afterSeg:  30, title: `RATIONALISING THE DENOMINATOR`, onScreen: `Clearing the root off the bottom of a fraction.` },
    { n: 27, afterSeg:  31, title: `WHY IT HAS TO GO`, onScreen: `Convention, mostly. A root on the bottom is treated as unfinished work.` },
    { n: 28, afterSeg:  32, title: `MULTIPLY TOP AND BOTTOM BY THE ROOT`, onScreen: `(1)/(2) × (2)/(2)` },
    { n: 29, afterSeg:  33, title: `THAT IS MULTIPLYING BY ONE`, onScreen: `(2)/(2) = 1, so the value cannot change — only the way it is written.` },
    { n: 30, afterSeg:  34, title: `ON THE BOTTOM`, onScreen: `= 2` },
    { n: 31, afterSeg:  36, title: `SO IT BECOMES`, onScreen: `(2)/(2) ✓ (boxed)` },
    { n: 32, afterSeg:  37, title: `THE ROOT MOVED UPSTAIRS`, onScreen: `same number, finished form` },
    { n: 33, afterSeg:  39, title: `ALMOST EVERY YEAR, QUESTION ONE HAS A ROOT IN…`, onScreen: `and it is always a solve for x` },
    { n: 34, afterSeg:  41, title: `TO KILL A ROOT, YOU SQUARE IT`, onScreen: `but squaring is dangerous — here is why` },
    { n: 35, afterSeg:  42, title: `COMPARE`, onScreen: `5² = 25  · (−5)² = 25 the same answer` },
    { n: 36, afterSeg:  43, title: `SQUARING THROWS THE SIGN AWAY`, onScreen: `it cannot tell 5 from negative 5` },
    { n: 37, afterSeg:  44, title: `SO SQUARING CAN INVENT AN ANSWER`, onScreen: `An x that satisfies the squared equation but never satisfied the original one.` },
    { n: 38, afterSeg:  45, title: `WHICH IS WHY EVERY ONE OF THESE ENDS WITH A…`, onScreen: `not optional, and worth a mark` },
    { n: 39, afterSeg:  47, title: `NSC PAPER 1 • NOVEMBER 2023`, onScreen: `NSC Mathematics P1 · November 2023 · Question 1.1.3 · 4 marks` },
    { n: 40, afterSeg:  48, title: `QUESTION 1.1.3`, onScreen: `2x + 1 = x − 1 · Solve for x.` },
    { n: 41, afterSeg:  49, title: `THE ROOT IS ALREADY ALONE`, onScreen: `so square both sides` },
    { n: 42, afterSeg:  50, title: `THE WHOLE SIDE, NOT THE PIECES`, onScreen: `You square each side of the equation as one thing.` },
    { n: 43, afterSeg:  51, title: `ON THE LEFT, THE ROOT GOES`, onScreen: `= 2x + 1` },
    { n: 44, afterSeg:  52, title: `AND ON THE RIGHT`, onScreen: `= (x − 1)(x − 1)` },
    { n: 45, afterSeg:  53, title: `COMPARE`, onScreen: `(x − 1)² x² − 2x + 1 · not x² − 1 episode 1 — the middle term` },
    { n: 46, afterSeg:  55, title: `SO THE EQUATION READS`, onScreen: `2x + 1 = x² − 2x + 1` },
    { n: 47, afterSeg:  57, title: `MAKE ONE SIDE ZERO`, onScreen: `0 = x² − 4x` },
    { n: 48, afterSeg:  58, title: `COMMON FACTOR — NOT THE FORMULA`, onScreen: `x(x − 4) = 0` },
    { n: 49, afterSeg:  59, title: `SPLIT IT`, onScreen: `x = 0 or x = 4` },
    { n: 50, afterSeg:  60, title: `NOW CHECK BOTH`, onScreen: `always both` },
    { n: 51, afterSeg:  61, title: `CHECK X = 4 VS CHECK X = 0`, onScreen: `3 = 3 ✓ · 1 ≠ −1 ✗` },
    { n: 52, afterSeg:  63, title: `SO ZERO IS NOT A SOLUTION`, onScreen: `red · reject x = 0` },
    { n: 53, afterSeg:  65, title: `THE SQUARING HANDED IT TO YOU`, onScreen: `The original equation never had it. Only the squared one did.` },
    { n: 54, afterSeg:  66, title: `SO THE ANSWER IS`, onScreen: `x = 4 ✓ (boxed)` },
    { n: 55, afterSeg:  67, title: `THIS IS THE ONE TO REMEMBER`, onScreen: `because of what the marking guideline says` },
    { n: 56, afterSeg:  68, title: `NSC PAPER 1 • NOVEMBER 2020`, onScreen: `NSC Mathematics P1 · November 2020 · Question 1.1.4 · 5 marks` },
    { n: 57, afterSeg:  69, title: `QUESTION 1.1.4`, onScreen: `x + 18 = x − 2 · Solve for x.` },
    { n: 58, afterSeg:  70, title: `ROOT IS ALONE — SQUARE BOTH SIDES`, onScreen: `x + 18 = (x − 2)²` },
    { n: 59, afterSeg:  72, title: `EXPAND CAREFULLY`, onScreen: `x² − 4x + 4` },
    { n: 60, afterSeg:  74, title: `MAKE ONE SIDE ZERO`, onScreen: `0 = x² − 5x − 14` },
    { n: 61, afterSeg:  76, title: `TWO NUMBERS`, onScreen: `−7 and 2` },
    { n: 62, afterSeg:  77, title: `SO IT FACTORISES AS`, onScreen: `(x − 7)(x + 2) = 0` },
    { n: 63, afterSeg:  78, title: `SPLIT IT`, onScreen: `x = 7 or x = −2` },
    { n: 64, afterSeg:  79, title: `AND AGAIN — CHECK BOTH`, onScreen: `the check is where this question is won` },
    { n: 65, afterSeg:  80, title: `CHECK X = 7 VS CHECK X = −2`, onScreen: `x = 7` },
    { n: 66, afterSeg:  81, title: `AND NEGATIVE TWO FAILS`, onScreen: `red · 4 ≠ −4` },
    { n: 67, afterSeg:  82, title: `MARK BREAKDOWN`, onScreen: `squaring both sides (1) · standard form (1) · factors (1) · both answers (1) · rejection of x = −2 (1)` },
    { n: 68, afterSeg:  83, title: `FOUR MARKS FOR THE ALGEBRA`, onScreen: `Squaring, standard form, the factors, both answers.` },
    { n: 69, afterSeg:  84, title: `THE FIFTH MARK IS THE REJECTION`, onScreen: `so it has to appear on your page` },
    { n: 70, afterSeg:  86, title: `THEY PAY YOU FOR THE REJECTION`, onScreen: `writing nothing is not the same as rejecting it` },
    { n: 71, afterSeg:  87, title: `ONE EXTRA STEP — AND A TRAP AT THE START`, onScreen: `this is where the root is not alone` },
    { n: 72, afterSeg:  88, title: `NSC PAPER 1 • NOVEMBER 2024`, onScreen: `NSC Mathematics P1 · November 2024 · Question 1.1.5 · 4 marks` },
    { n: 73, afterSeg:  89, title: `QUESTION 1.1.5`, onScreen: `−2x + 4 − x = 2 · Solve for x.` },
    { n: 74, afterSeg:  90, title: `TYLA SQUARES STRAIGHT AWAY`, onScreen: `red · −2x + 4 − x² = 4 ✗` },
    { n: 75, afterSeg:  91, title: `WHAT DID YOU ACTUALLY SQUARE?`, onScreen: `each piece — and that is the mistake` },
    { n: 76, afterSeg:  93, title: `BACK TO EPISODE 1`, onScreen: `(a − b)² ≠ a² − b²` },
    { n: 77, afterSeg:  95, title: `ISOLATE THE ROOT FIRST`, onScreen: `Squaring is only safe when the root is alone on its side.` },
    { n: 78, afterSeg:  96, title: `ADD X TO BOTH SIDES`, onScreen: `−2x + 4 = 2 + x` },
    { n: 79, afterSeg:  97, title: `AND THAT STEP IS A MARK`, onScreen: `The guideline gives one just for isolating the root.` },
    { n: 80, afterSeg:  98, title: `NOW SQUARING IS SAFE`, onScreen: `= 4 + 4x + x²` },
    { n: 81, afterSeg:  99, title: `MAKE ONE SIDE ZERO`, onScreen: `0 = x² + 6x` },
    { n: 82, afterSeg: 100, title: `COMMON FACTOR, AND SPLIT`, onScreen: `x = 0 or x = −6` },
    { n: 83, afterSeg: 102, title: `CHECK X = 0`, onScreen: `= 2 ✓` },
    { n: 84, afterSeg: 103, title: `NOW CHECK X = −6`, onScreen: `16 = 4` },
    { n: 85, afterSeg: 104, title: `AND THEN MINUS NEGATIVE SIX`, onScreen: `4 − (−6) = 4 + 6` },
    { n: 86, afterSeg: 105, title: `WHICH COMES TO`, onScreen: `red · = 10, not 2 ✗` },
    { n: 87, afterSeg: 106, title: `SO REJECT IT`, onScreen: `x = 0 ✓ (boxed)` },
    { n: 88, afterSeg: 107, title: `WHERE YOU LOSE MARKS`, onScreen: `WHERE YOU LOSE MARKS` },
    { n: 89, afterSeg: 108, title: `POINT 1 • ISOLATE THE ROOT BEFORE YOU SQUARE`, onScreen: `Isolate the root before you square — always — and it is worth a mark on its own` },
    { n: 90, afterSeg: 109, title: `POINT 2 • (X − 1)² IS NOT X² − 1`, onScreen: `(x − 1)² is not x² − 1 — expand it properly, every time` },
    { n: 91, afterSeg: 110, title: `POINT 3 • WRITE THE REJECTION DOWN`, onScreen: `Write the rejection down — they pay for it — leaving it out is not the same thing` },
    { n: 92, afterSeg: 111, title: `REMEMBER`, onScreen: `REMEMBER` },
    { n: 93, afterSeg: 112, title: `POINT 1 • SQUARING FORGETS THE SIGN`, onScreen: `Squaring forgets the sign — so it can invent an answer that was never there` },
    { n: 94, afterSeg: 113, title: `POINT 2 • A ROOT SPLITS ACROSS A MULTIPLY`, onScreen: `A root splits across a multiply — never across a plus` },
    { n: 95, afterSeg: 114, title: `YOUR TURN`, onScreen: `3x = x − 4 · solve for x` },
    { n: 96, afterSeg: 115, title: `PAUSE AND TRY`, onScreen: `PAUSE AND TRY` },
    { n: 97, afterSeg: 116, title: `AND CHECK BOTH`, onScreen: `One of the two answers will not survive the check.` },
    { n: 98, afterSeg: 117, title: `NEXT • NATURE OF ROOTS`, onScreen: `NEXT — EPISODE 9: THE NATURE OF ROOTS` },
  ],
},
{
  num: 9,
  series: 'Revision-Part-1',
  file: 'Episode 9 - Nature of Roots',
  segs: [
    { s: 'AMELIA',   t: `Episode nine. The nature of roots.` },
    { s: 'MICHAEL',  t: `The last one in this series. And the only part of it that is properly Grade twelve work.` },
    { s: 'TYLA',     t: `Homework first.` },
    { s: 'MICHAEL',  t: `Solve for x. Three, times the square root of x, equals x minus four.` },
    { s: 'TYLA',     t: `The root is alone on the left, so I square both sides.` },
    { s: 'TYLA',     t: `Three squared is nine, and the square root of x, squared, is x. So the left becomes nine x.` },
    { s: 'MICHAEL',  t: `Good. The three gets squared too, because the whole side gets squared.` },
    { s: 'TYLA',     t: `And on the right, bracket x minus four, all squared. Which is x squared, minus eight x, plus sixteen.` },
    { s: 'MICHAEL',  t: `Make one side zero.` },
    { s: 'TYLA',     t: `Zero equals x squared, minus seventeen x, plus sixteen.` },
    { s: 'TYLA',     t: `Two numbers that multiply to sixteen and add to negative seventeen. Negative sixteen and negative one.` },
    { s: 'TYLA',     t: `So x is sixteen, or x is one.` },
    { s: 'MICHAEL',  t: `Check both.` },
    { s: 'TYLA',     t: `For sixteen. Three times the square root of sixteen is three times four, which is twelve. And sixteen minus four is twelve. That works.` },
    { s: 'TYLA',     t: `For one. Three times the square root of one is three. But one minus four is negative three.` },
    { s: 'MICHAEL',  t: `Three is not negative three. So reject it, and write the rejection down.` },
    { s: 'TYLA',     t: `So x equals sixteen.` },
    { s: 'MICHAEL',  t: `Now. The nature of the roots.` },
    { s: 'TYLA',     t: `What does nature mean here?` },
    { s: 'MICHAEL',  t: `What kind of answers the equation has. Before you solve it. Often without solving it at all.` },
    { s: 'TYLA',     t: `You can tell without solving?` },
    { s: 'MICHAEL',  t: `You can, and that is the entire point of this topic.` },
    { s: 'MICHAEL',  t: `Think back to episode four. The quadratic formula.` },
    { s: 'MICHAEL',  t: `x equals negative b, plus or minus the square root of, b squared minus four a c, all divided by two a.` },
    { s: 'MICHAEL',  t: `Every part of that formula behaves itself, except one. The part underneath the root.` },
    { s: 'TYLA',     t: `b squared minus four a c.` },
    { s: 'MICHAEL',  t: `That part has a name. It is called the discriminant. And it has a symbol, a triangle, called delta.` },
    { s: 'MICHAEL',  t: `And it decides everything, because you are about to take its square root.` },
    { s: 'MICHAEL',  t: `So. If delta is positive, you can take the root, and the plus or minus hands you two different answers.` },
    { s: 'TYLA',     t: `Two real roots.` },
    { s: 'MICHAEL',  t: `If delta is zero, the square root of zero is zero. And plus zero and minus zero are the same thing.` },
    { s: 'TYLA',     t: `So the two answers land on top of each other.` },
    { s: 'MICHAEL',  t: `One answer. And we say the roots are real and equal.` },
    { s: 'MICHAEL',  t: `And if delta is negative, you are being asked for the square root of a negative number.` },
    { s: 'TYLA',     t: `Which does not exist.` },
    { s: 'MICHAEL',  t: `Not in the numbers you work with. So we say the roots are non real.` },
    { s: 'MICHAEL',  t: `There is one more split, and it is worth a mark. When delta is positive, ask whether it is a perfect square.` },
    { s: 'TYLA',     t: `Like four, or nine, or twenty five.` },
    { s: 'MICHAEL',  t: `Then its root is a whole number, and the answers come out as whole numbers or fractions. Those are rational.` },
    { s: 'MICHAEL',  t: `If delta is positive but not a perfect square, the root stays a surd, and the answers are irrational.` },
    { s: 'TYLA',     t: `Episode eight.` },
    { s: 'MICHAEL',  t: `Episode eight. And now one word that catches people out. Real.` },
    { s: 'MICHAEL',  t: `Real means delta is greater than or equal to zero.` },
    { s: 'TYLA',     t: `So equal roots still count as real?` },
    { s: 'MICHAEL',  t: `They do. Real includes equal. If the question says real, your condition carries an equal to. If it says two different roots, it does not.` },
    { s: 'MICHAEL',  t: `Example one, and this is the friendly shape.` },
    { s: 'AMELIA',   t: `National Senior Certificate, Mathematics Paper One, November two thousand and twelve. Question one point three.` },
    { s: 'MICHAEL',  t: `The solutions of a quadratic equation are given by x equals negative two, plus or minus the square root of, two p plus five, all divided by seven.` },
    { s: 'MICHAEL',  t: `Part one. For which values of p will the equation have two equal solutions. Two marks.` },
    { s: 'TYLA',     t: `But there is no a, and no b, and no c.` },
    { s: 'MICHAEL',  t: `You do not need them. They have already done the formula for you. The discriminant is sitting right there, under the root.` },
    { s: 'TYLA',     t: `So the discriminant is two p plus five.` },
    { s: 'MICHAEL',  t: `That is it. Now, equal solutions.` },
    { s: 'TYLA',     t: `Delta equals zero. So two p plus five equals zero.` },
    { s: 'TYLA',     t: `Two p is negative five. So p is negative two comma five.` },
    { s: 'MICHAEL',  t: `And look at how they mark it. Two marks. One for writing two p plus five equals zero, and one for the answer.` },
    { s: 'TYLA',     t: `So the condition is a mark on its own.` },
    { s: 'MICHAEL',  t: `Every single time. If you only write the final answer, you throw away half the question.` },
    { s: 'MICHAEL',  t: `Part two. No real solutions. One mark.` },
    { s: 'TYLA',     t: `Non real means delta is less than zero. So two p plus five is less than zero.` },
    { s: 'TYLA',     t: `Which gives p less than negative two comma five.` },
    { s: 'MICHAEL',  t: `Test it. Try p equals negative three. Two times negative three is negative six, plus five is negative one.` },
    { s: 'TYLA',     t: `The square root of negative one. Non real. Correct.` },
    { s: 'MICHAEL',  t: `Example two. Now they make you build the discriminant yourself.` },
    { s: 'AMELIA',   t: `National Senior Certificate, Mathematics Paper One, November two thousand and fifteen. Question one point three.` },
    { s: 'MICHAEL',  t: `Determine the values of k for which x squared plus x, equals k, will have non real roots. Four marks.` },
    { s: 'TYLA',     t: `So a is one, b is one, and c is k.` },
    { s: 'MICHAEL',  t: `Stop there. Look at the equation again.` },
    { s: 'TYLA',     t: `x squared plus x equals k.` },
    { s: 'MICHAEL',  t: `Is that in standard form?` },
    { s: 'TYLA',     t: `No. It does not equal zero yet.` },
    { s: 'MICHAEL',  t: `And a, b and c mean nothing at all until it does. Take the k across first.` },
    { s: 'TYLA',     t: `x squared plus x minus k equals zero. So c is negative k, not k.` },
    { s: 'MICHAEL',  t: `One sign, and the whole question is gone. Now write the condition.` },
    { s: 'TYLA',     t: `Non real, so delta is less than zero.` },
    { s: 'MICHAEL',  t: `Substitute.` },
    { s: 'TYLA',     t: `b squared is one. Then minus four, times one, times negative k.` },
    { s: 'TYLA',     t: `Two negatives make a plus, so that is plus four k. So one plus four k, is less than zero.` },
    { s: 'MICHAEL',  t: `Solve it.` },
    { s: 'TYLA',     t: `Four k is less than negative one. So k is less than negative one quarter.` },
    { s: 'MICHAEL',  t: `Test it. Take k equals negative one.` },
    { s: 'TYLA',     t: `x squared plus x plus one equals zero. Delta is one, minus four, which is negative three.` },
    { s: 'TYLA',     t: `Negative. So non real. It works.` },
    { s: 'MICHAEL',  t: `Now test the boundary. k equals negative one quarter.` },
    { s: 'TYLA',     t: `Delta is one, plus four times negative one quarter. One minus one. Zero.` },
    { s: 'MICHAEL',  t: `And zero is equal roots, which are real. So the boundary is not included.` },
    { s: 'TYLA',     t: `Which is why the answer has no equal to in it.` },
    { s: 'MICHAEL',  t: `Example three. This one asks you to prove something, and the marks are in the working.` },
    { s: 'AMELIA',   t: `National Senior Certificate, Mathematics Paper One, November two thousand and twenty one. Question one point three.` },
    { s: 'MICHAEL',  t: `Given that m divided by n, equals n divided by p, where m, n and p are non zero real numbers.` },
    { s: 'MICHAEL',  t: `Show that the roots of, m x squared, plus n x, plus p, equals zero, are non real. Four marks.` },
    { s: 'TYLA',     t: `There are no numbers anywhere.` },
    { s: 'MICHAEL',  t: `There do not need to be. Start with what you were given, and cross multiply it.` },
    { s: 'TYLA',     t: `m times p equals n times n. So n squared equals m p.` },
    { s: 'MICHAEL',  t: `Hold on to that. Now write down the discriminant for the equation.` },
    { s: 'TYLA',     t: `a is m, b is n, and c is p. So delta is n squared, minus four m p.` },
    { s: 'MICHAEL',  t: `And you have just been told what n squared is.` },
    { s: 'TYLA',     t: `n squared is m p. So delta is m p, minus four m p.` },
    { s: 'TYLA',     t: `Which is negative three m p.` },
    { s: 'MICHAEL',  t: `Or, swapping it the other way, negative three n squared. Use that one.` },
    { s: 'TYLA',     t: `Why that one?` },
    { s: 'MICHAEL',  t: `Because of what you can say about it. n squared is a square.` },
    { s: 'TYLA',     t: `And a square is never negative.` },
    { s: 'MICHAEL',  t: `And n is not zero, so n squared is strictly positive. Which makes negative three n squared strictly negative.` },
    { s: 'TYLA',     t: `So delta is less than zero. The roots are non real.` },
    { s: 'MICHAEL',  t: `And that line, delta is less than zero, is where the mark is. Not the sentence you write afterwards.` },
    { s: 'TYLA',     t: `So I have to actually put it on the page.` },
    { s: 'MICHAEL',  t: `Put it on the page. A show that question pays for the steps, not for the conclusion.` },
    { s: 'MICHAEL',  t: `Three things.` },
    { s: 'MICHAEL',  t: `Number one. Standard form before a, b and c. Always. One sign will cost you the whole question.` },
    { s: 'MICHAEL',  t: `Number two. Real means delta is greater than or equal to zero. Equal roots are still real.` },
    { s: 'MICHAEL',  t: `Number three. Write the condition, not only the answer. It is a separate mark, every time.` },
    { s: 'MICHAEL',  t: `Two things to remember.` },
    { s: 'MICHAEL',  t: `One. The discriminant is the part under the root, and it decides everything.` },
    { s: 'MICHAEL',  t: `Two. A square is never negative. That one fact proves most of these questions.` },
    { s: 'MICHAEL',  t: `Here is your last question. The roots of a quadratic equation are given by x equals three, plus or minus the square root of, negative k minus four, all divided by two.` },
    { s: 'MICHAEL',  t: `For which values of k are the roots real?` },
    { s: 'MICHAEL',  t: `Pause and try it. I will wait.`, pause: 3.0 },
    { s: 'TYLA',     t: `Real, so greater than or equal to zero. And watch the sign when you divide by a negative.` },
    { s: 'MICHAEL',  t: `And that is Revision Part One. Nine episodes, and the whole of Question One.` },
    { s: 'TYLA',     t: `Every mark of it.` },
    { s: 'MICHAEL',  t: `See you in the next series.` },
  ],
  slides: [
    { n:  1, afterSeg:   0, title: `REVISION 1 • EPISODE 9 • THE NATURE OF ROOTS`, onScreen: `EPISODE 9 — THE NATURE OF ROOTS` },
    { n:  2, afterSeg:   1, title: `THE LAST ONE — AND THE ONLY GRADE 12 PIECE IN…`, onScreen: `everything before this was ground the ATP assumes you have` },
    { n:  3, afterSeg:   3, title: `YOUR HOMEWORK`, onScreen: `3x = x − 4 · solve for x` },
    { n:  4, afterSeg:   4, title: `THE ROOT IS ALONE — SQUARE BOTH SIDES`, onScreen: `(3x)² = (x − 4)²` },
    { n:  5, afterSeg:   5, title: `THE THREE GETS SQUARED TOO`, onScreen: `the left is 9x` },
    { n:  6, afterSeg:   7, title: `AND ON THE RIGHT`, onScreen: `x² − 8x + 16` },
    { n:  7, afterSeg:   9, title: `MAKE ONE SIDE ZERO`, onScreen: `0 = x² − 17x + 16` },
    { n:  8, afterSeg:  10, title: `TWO NUMBERS`, onScreen: `−16 and −1` },
    { n:  9, afterSeg:  11, title: `SO IT SPLITS AS`, onScreen: `x = 16 or x = 1` },
    { n: 10, afterSeg:  13, title: `CHECK X = 16`, onScreen: `12 = 12 ✓` },
    { n: 11, afterSeg:  14, title: `AND CHECK X = 1`, onScreen: `red · 3 ≠ −3 ✗` },
    { n: 12, afterSeg:  15, title: `REJECT IT — IN WRITING`, onScreen: `x = 16 ✓ (boxed)` },
    { n: 13, afterSeg:  17, title: `THE NATURE OF THE ROOTS`, onScreen: `THE NATURE OF THE ROOTS` },
    { n: 14, afterSeg:  19, title: `WHAT KIND OF ANSWERS IT HAS`, onScreen: `Before you solve it. Often without solving it at all.` },
    { n: 15, afterSeg:  21, title: `YOU CAN TELL WITHOUT SOLVING`, onScreen: `and that is the whole point of this topic` },
    { n: 16, afterSeg:  23, title: `EPISODE 4 · THE QUADRATIC FORMULA`, onScreen: `x = (−b ± b² − 4ac)/(2a)` },
    { n: 17, afterSeg:  24, title: `EVERYTHING BEHAVES — EXCEPT THE PART UNDER…`, onScreen: `that is the only piece that can misbehave` },
    { n: 18, afterSeg:  26, title: `THE DISCRIMINANT`, onScreen: `Δ = b² − 4ac` },
    { n: 19, afterSeg:  27, title: `DELTA DECIDES EVERYTHING`, onScreen: `Because you are about to take its square root.` },
    { n: 20, afterSeg:  28, title: `IF DELTA IS POSITIVE`, onScreen: `two different real roots` },
    { n: 21, afterSeg:  30, title: `IF DELTA IS ZERO`, onScreen: `the two answers land on top of each other` },
    { n: 22, afterSeg:  32, title: `SO`, onScreen: `real and equal ✓ (boxed)` },
    { n: 23, afterSeg:  33, title: `AND IF DELTA IS NEGATIVE`, onScreen: `red · there is no such number` },
    { n: 24, afterSeg:  35, title: `SO THE ROOTS ARE NON-REAL`, onScreen: `not in the numbers you work with` },
    { n: 25, afterSeg:  36, title: `MARK BREAKDOWN`, onScreen: `two different real roots () · real and equal — one root () · non-real ()` },
    { n: 26, afterSeg:  37, title: `COMPARE`, onScreen: `Δ = 4, 9, 25 … a perfect square · Δ = 5, 12, 28 … not a perfect square` },
    { n: 27, afterSeg:  38, title: `A PERFECT SQUARE MEANS A WHOLE ROOT`, onScreen: `so the answers are rational` },
    { n: 28, afterSeg:  39, title: `AND IF IT IS NOT`, onScreen: `the answers are irrational` },
    { n: 29, afterSeg:  41, title: `MARK BREAKDOWN`, onScreen: `real and unequal () · rational () · irrational () · real and equal () · non-real ()` },
    { n: 30, afterSeg:  42, title: `THE WORD THAT CATCHES PEOPLE`, onScreen: `Real means Δ ≥ 0. Equal roots are still real.` },
    { n: 31, afterSeg:  44, title: `COMPARE`, onScreen: `“real” Δ ≥ 0 — with the equal to · “two different” Δ > 0 — without it` },
    { n: 32, afterSeg:  45, title: `THE FRIENDLY SHAPE — THEY HAND YOU THE ROOT`, onScreen: `no a, no b, no c needed` },
    { n: 33, afterSeg:  46, title: `NSC PAPER 1 • NOVEMBER 2012`, onScreen: `NSC Mathematics P1 · November 2012 · Question 1.3 · 2 + 1 marks` },
    { n: 34, afterSeg:  47, title: `QUESTION 1.3`, onScreen: `x = (−2 ± 2p + 5)/(7) · The solutions of a quadratic equation are given above.` },
    { n: 35, afterSeg:  48, title: `QUESTION 1.3.1`, onScreen: `two equal solutions · For which value(s) of p?` },
    { n: 36, afterSeg:  50, title: `THEY HAVE DONE THE FORMULA FOR YOU`, onScreen: `The discriminant is already sitting there, under the root.` },
    { n: 37, afterSeg:  51, title: `SO THE DISCRIMINANT IS`, onScreen: `Δ = 2p + 5` },
    { n: 38, afterSeg:  53, title: `EQUAL SOLUTIONS MEANS DELTA IS ZERO`, onScreen: `2p + 5 = 0` },
    { n: 39, afterSeg:  54, title: `SOLVE IT`, onScreen: `p = −2,5 ✓ (boxed)` },
    { n: 40, afterSeg:  55, title: `MARK BREAKDOWN`, onScreen: `2p + 5 = 0 — the condition (1) · p = −2,5 — the answer (1)` },
    { n: 41, afterSeg:  56, title: `THE CONDITION IS A MARK ON ITS OWN`, onScreen: `every single time` },
    { n: 42, afterSeg:  57, title: `ONLY THE ANSWER IS HALF THE QUESTION`, onScreen: `Writing p = −2,5 with nothing above it scores one of the two.` },
    { n: 43, afterSeg:  58, title: `QUESTION 1.3.2`, onScreen: `no real solutions · For which value(s) of p?` },
    { n: 44, afterSeg:  59, title: `NON-REAL MEANS DELTA IS NEGATIVE`, onScreen: `2p + 5 < 0` },
    { n: 45, afterSeg:  60, title: `SOLVE IT`, onScreen: `p < −2,5 ✓ (boxed)` },
    { n: 46, afterSeg:  61, title: `TEST IT WITH P = −3`, onScreen: `= −1` },
    { n: 47, afterSeg:  62, title: `AND THAT IS THE POINT`, onScreen: `non-real ✓ ✓ (boxed)` },
    { n: 48, afterSeg:  63, title: `NOW YOU BUILD THE DISCRIMINANT YOURSELF`, onScreen: `and that is where the trap is` },
    { n: 49, afterSeg:  64, title: `NSC PAPER 1 • NOVEMBER 2015`, onScreen: `NSC Mathematics P1 · November 2015 · Question 1.3 · 4 marks` },
    { n: 50, afterSeg:  65, title: `QUESTION 1.3`, onScreen: `x² + x = k · Determine the value(s) of k for which the roots are non-real.` },
    { n: 51, afterSeg:  66, title: `TYLA READS THEM STRAIGHT OFF`, onScreen: `red · a = 1, b = 1, c = k ✗` },
    { n: 52, afterSeg:  67, title: `LOOK AT THE EQUATION AGAIN`, onScreen: `is it in standard form?` },
    { n: 53, afterSeg:  69, title: `COMPARE`, onScreen: `x² + x = k not standard form · x² + x − k = 0 standard form` },
    { n: 54, afterSeg:  71, title: `TAKE THE K ACROSS FIRST`, onScreen: `c = −k, not k` },
    { n: 55, afterSeg:  72, title: `ONE SIGN, AND THE QUESTION IS GONE`, onScreen: `a, b and c mean nothing until one side is zero.` },
    { n: 56, afterSeg:  73, title: `NOW WRITE THE CONDITION`, onScreen: `Δ < 0` },
    { n: 57, afterSeg:  75, title: `SUBSTITUTE`, onScreen: `two negatives → + 4k` },
    { n: 58, afterSeg:  77, title: `SO THE CONDITION READS`, onScreen: `4k < −1` },
    { n: 59, afterSeg:  79, title: `AND THE ANSWER`, onScreen: `k < − (1)/(4) ✓ (boxed)` },
    { n: 60, afterSeg:  80, title: `TEST IT WITH K = −1`, onScreen: `Δ = 1 − 4 = −3` },
    { n: 61, afterSeg:  82, title: `NEGATIVE, SO NON-REAL`, onScreen: `it works ✓` },
    { n: 62, afterSeg:  83, title: `NOW TEST THE BOUNDARY`, onScreen: `Δ = 1 + 4(− (1)/(4) ) = 0` },
    { n: 63, afterSeg:  85, title: `ZERO IS EQUAL ROOTS — WHICH ARE REAL`, onScreen: `So the boundary itself is not part of the answer.` },
    { n: 64, afterSeg:  86, title: `WHICH IS WHY THERE IS NO EQUAL TO IN THE…`, onScreen: `k < −¼, strictly` },
    { n: 65, afterSeg:  87, title: `A SHOW THAT QUESTION — THE MARKS ARE IN THE…`, onScreen: `not in the sentence at the end` },
    { n: 66, afterSeg:  88, title: `NSC PAPER 1 • NOVEMBER 2021`, onScreen: `NSC Mathematics P1 · November 2021 · Question 1.3 · 4 marks` },
    { n: 67, afterSeg:  89, title: `QUESTION 1.3`, onScreen: `(m)/(n) = (n)/(p) · m, n and p are non-zero real numbers.` },
    { n: 68, afterSeg:  90, title: `QUESTION 1.3`, onScreen: `mx² + nx + p = 0 · Show that the roots of this equation are non-real.` },
    { n: 69, afterSeg:  92, title: `START WITH WHAT YOU WERE GIVEN`, onScreen: `and cross multiply it` },
    { n: 70, afterSeg:  93, title: `CROSS MULTIPLY`, onScreen: `n² = mp` },
    { n: 71, afterSeg:  95, title: `NOW THE DISCRIMINANT`, onScreen: `Δ = n² − 4mp` },
    { n: 72, afterSeg:  97, title: `AND YOU KNOW WHAT N² IS`, onScreen: `Δ = mp − 4mp` },
    { n: 73, afterSeg:  98, title: `WHICH COMES TO`, onScreen: `Δ = −3mp` },
    { n: 74, afterSeg:  99, title: `OR, SWAPPING BACK`, onScreen: `Δ = −3n²` },
    { n: 75, afterSeg: 101, title: `BECAUSE OF WHAT YOU CAN SAY ABOUT IT`, onScreen: `n² is a square` },
    { n: 76, afterSeg: 102, title: `A SQUARE IS NEVER NEGATIVE`, onScreen: `And n is not zero, so n² is strictly positive.` },
    { n: 77, afterSeg: 103, title: `SO`, onScreen: `Δ < 0 · non-real ✓ (boxed)` },
    { n: 78, afterSeg: 105, title: `THAT LINE IS THE MARK`, onScreen: `Δ < 0 is what they pay for — not the sentence you write after it.` },
    { n: 79, afterSeg: 107, title: `A SHOW THAT PAYS FOR THE STEPS`, onScreen: `never for the conclusion` },
    { n: 80, afterSeg: 108, title: `WHERE YOU LOSE MARKS`, onScreen: `WHERE YOU LOSE MARKS` },
    { n: 81, afterSeg: 109, title: `POINT 1 • STANDARD FORM FIRST`, onScreen: `Standard form first — a, b and c mean nothing until one side is zero — and one sign costs the question` },
    { n: 82, afterSeg: 110, title: `POINT 2 • REAL MEANS Δ ≥ 0`, onScreen: `Real means Δ ≥ 0 — equal roots are still real` },
    { n: 83, afterSeg: 111, title: `POINT 3 • WRITE THE CONDITION, NOT JUST THE ANSWER`, onScreen: `Write the condition, not just the answer — it is a separate mark, every time` },
    { n: 84, afterSeg: 112, title: `REMEMBER`, onScreen: `REMEMBER` },
    { n: 85, afterSeg: 113, title: `POINT 1 • THE DISCRIMINANT IS THE PART UNDER THE ROOT`, onScreen: `The discriminant is the part under the root — and it decides everything` },
    { n: 86, afterSeg: 114, title: `POINT 2 • A SQUARE IS NEVER NEGATIVE`, onScreen: `A square is never negative — that one fact proves most of these` },
    { n: 87, afterSeg: 115, title: `YOUR LAST QUESTION`, onScreen: `x = (3 ± −k − 4)/(2) · for which values of k are the roots real?` },
    { n: 88, afterSeg: 117, title: `PAUSE AND TRY`, onScreen: `PAUSE AND TRY` },
    { n: 89, afterSeg: 118, title: `WATCH THE SIGN`, onScreen: `episode 6` },
    { n: 90, afterSeg: 119, title: `THAT IS REVISION PART ONE`, onScreen: `THAT IS REVISION PART ONE · nine episodes · the whole of Question One` },
