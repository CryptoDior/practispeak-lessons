    { n: 65, afterSeg:  83, title: `AND THE RANGE, FOR THE SAME REASON`, onScreen: `y ∈ ℝ, y ≠ 2` },
    { n: 66, afterSeg:  84, title: `X-INTERCEPT — MAKE Y ZERO`, onScreen: `(−1)/(x − 3) = −2` },
    { n: 67, afterSeg:  86, title: `CLEAR THE FRACTION`, onScreen: `2x − 6 = 1` },
    { n: 68, afterSeg:  87, title: `SO`, onScreen: `(3,5 ; 0) ✓ (boxed)` },
    { n: 69, afterSeg:  89, title: `Y-INTERCEPT — MAKE X ZERO`, onScreen: `(0 ; 2,33) ✓ (boxed)` },
    { n: 70, afterSeg:  90, title: `THE MEMO WRITES IT AS 2,33`, onScreen: `Two and a third. Either form is accepted.` },
    { n: 71, afterSeg:  91, title: `AND NOW DRAW IT — 3 MARKS`, onScreen: `f · asymptotes x = 3 · y = 2` },
    { n: 72, afterSeg:  93, title: `MARK BREAKDOWN`, onScreen: `the shape (1) · the asymptotes (1) · the intercepts with the axes (1)` },
    { n: 73, afterSeg:  94, title: `NSC PAPER 1 • NOVEMBER 2012`, onScreen: `NSC Mathematics P1 · November 2012 · Question 4.2 · 13 marks` },
    { n: 74, afterSeg:  95, title: `QUESTION 4.2`, onScreen: `S(−2 ; 0) T(6 ; 0) · the x-intercepts of f(x) = ax² + bx + c, with R the y-intercept` },
    { n: 75, afterSeg:  96, title: `AND THE LINE`, onScreen: `g(x) = −2x + d · Determine d, then the equation of f.` },
    { n: 76, afterSeg:  97, title: `NO PICTURE — AND YOU STILL KNOW WHERE…`, onScreen: `read the words and the graph builds itself` },
    { n: 77, afterSeg:  99, title: `THE LINE GOES THROUGH T(6 ; 0)`, onScreen: `0 = −12 + d` },
    { n: 78, afterSeg: 100, title: `SO`, onScreen: `g(x) = −2x + 12 ✓ (boxed)` },
    { n: 79, afterSeg: 101, title: `AND THAT HANDS YOU R FOR FREE`, onScreen: `R is on the line as well` },
    { n: 80, afterSeg: 102, title: `RUN THE WHOLE LIST ON IT`, onScreen: `g(x) = −2x + 12` },
    { n: 81, afterSeg: 103, title: `GRADIENT — IT IS ALREADY IN STANDARD FORM`, onScreen: `g(x) = −2x + 12` },
    { n: 82, afterSeg: 105, title: `THE INTERCEPTS`, onScreen: `g(x) = −2x + 12` },
    { n: 83, afterSeg: 107, title: `DOMAIN AND RANGE`, onScreen: `g(x) = −2x + 12` },
    { n: 84, afterSeg: 109, title: `AND THE GRADIENT IS NEGATIVE`, onScreen: `g(x) = −2x + 12` },
    { n: 85, afterSeg: 110, title: `FIVE QUICK MARKS`, onScreen: `That is the full characteristics list for a straight line.` },
    { n: 86, afterSeg: 111, title: `BECAUSE R IS THE Y-INTERCEPT`, onScreen: `g(0) = 12` },
    { n: 87, afterSeg: 112, title: `R IS ON THE PARABOLA TOO`, onScreen: `R(0 ; 12) ✓ (boxed)` },
    { n: 88, afterSeg: 114, title: `BOTH x-INTERCEPTS? USE FACTOR FORM`, onScreen: `y = a(x − 6)(x + 2) — those brackets are zero at 6 and at −2.` },
    { n: 89, afterSeg: 116, title: `NOW USE R TO FIND A`, onScreen: `a = −1` },
    { n: 90, afterSeg: 117, title: `SO THE FACTOR FORM IS`, onScreen: `y = −(x − 6)(x + 2)` },
    { n: 91, afterSeg: 118, title: `MULTIPLY IT OUT`, onScreen: `f(x) = −x² + 4x + 12 ✓ (boxed)` },
    { n: 92, afterSeg: 119, title: `NO MARKS FOR ANSWER ONLY`, onScreen: `The guideline says it in those words. Four marks, four lines of working.` },
    { n: 93, afterSeg: 120, title: `FOUR MARKS, FOUR LINES OF WORKING`, onScreen: `a guessed answer is worth nothing here` },
    { n: 94, afterSeg: 121, title: `QUESTION 4.2.3`, onScreen: `the turning point · Calculate its coordinates.` },
    { n: 95, afterSeg: 122, title: `THE TURNING POINT SITS HALFWAY`, onScreen: `x = 2` },
    { n: 96, afterSeg: 124, title: `AND ITS HEIGHT`, onScreen: `(2 ; 16) ✓ (boxed)` },
    { n: 97, afterSeg: 125, title: `THE WHOLE PICTURE`, onScreen: `f(x) = −x² + 4x + 12 · g(x) = −2x + 12` },
    { n: 98, afterSeg: 126, title: `QUESTION 4.2.4`, onScreen: `f(x) = k · For which values of k will this have two distinct roots?` },
    { n: 99, afterSeg: 127, title: `WHAT IS IT EVEN ASKING?`, onScreen: `Where a flat horizontal line, at height k, cuts the parabola twice.` },
    { n: 100, afterSeg: 128, title: `A FLAT LINE AT HEIGHT K, SLIDING UP AND DOWN`, onScreen: `where does it cut the parabola twice?` },
    { n: 101, afterSeg: 130, title: `SLIDE IT UP`, onScreen: `f · k = 16 — touches once · k = 8 — cuts twice` },
    { n: 102, afterSeg: 132, title: `ABOVE 16 IT MISSES COMPLETELY`, onScreen: `k < 16 ✓ (boxed)` },
    { n: 103, afterSeg: 133, title: `WHERE YOU LOSE MARKS`, onScreen: `WHERE YOU LOSE MARKS` },
    { n: 104, afterSeg: 134, title: `POINT 1 • READ WHICH INTERCEPT THEY ASKED FOR`, onScreen: `Read which intercept they asked for — swapping them scores zero, even with both numbers right` },
    { n: 105, afterSeg: 135, title: `POINT 2 • DRAW THE ASYMPTOTES, DOTTED`, onScreen: `Draw the asymptotes, dotted — on a sketch they carry their own mark` },
    { n: 106, afterSeg: 136, title: `POINT 3 • A RANGE AGAINST AN ASYMPTOTE IS STRICTLY…`, onScreen: `A range against an asymptote is strictly greater — never greater than or equal to` },
    { n: 107, afterSeg: 137, title: `REMEMBER`, onScreen: `REMEMBER` },
    { n: 108, afterSeg: 138, title: `POINT 1 • WHERE THE X SITS TELLS YOU THE SHAPE`, onScreen: `Where the x sits tells you the shape — on its own, squared, underneath, or up as the power` },
    { n: 109, afterSeg: 139, title: `POINT 2 • FIND THE ASYMPTOTES FIRST`, onScreen: `Find the asymptotes first — for a hyperbola and an exponential, everything else hangs off them` },
