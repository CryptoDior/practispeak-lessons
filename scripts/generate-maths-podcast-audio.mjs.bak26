    { n: 41, afterSeg:  54, title: `SAME BASE`, onScreen: `(1 ; 0) ✓ (boxed)` },
    { n: 42, afterSeg:  55, title: `WHAT THE MEMO SAYS`, onScreen: `WHAT THE MEMO SAYS` },
    { n: 43, afterSeg:  56, title: `INTERCHANGING 4.1.1 AND 4.1.2`, onScreen: `The marking guideline prints it: 0 out of 3 marks.` },
    { n: 44, afterSeg:  57, title: `GIVE THE X WHERE THEY ASKED FOR THE Y`, onScreen: `red · 0 out of 3 ✗` },
    { n: 45, afterSeg:  58, title: `ALL THREE MARKS — NOT ONE`, onScreen: `with both numbers correct` },
    { n: 46, afterSeg:  60, title: `SO READ IT TWICE`, onScreen: `Which intercept did they ask for? It is printed, and it is free.` },
