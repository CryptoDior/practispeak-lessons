    { n: 55, afterSeg:  70, title: `THAT EQUAL SIGN IS A MARK`, onScreen: `A range that sits against an asymptote is strictly greater than.` },
    { n: 56, afterSeg:  71, title: `NSC PAPER 1 • NOVEMBER 2021`, onScreen: `NSC Mathematics P1 · November 2021 · Question 5 · 10 marks` },
    { n: 57, afterSeg:  72, title: `QUESTION 5`, onScreen: `f(x) = (−1)/(x − 3) + 2 · Given the function above.` },
    { n: 58, afterSeg:  73, title: `THE X IS ON THE BOTTOM — A HYPERBOLA`, onScreen: `and a hyperbola is two asymptotes with a curve draped around them` },
    { n: 59, afterSeg:  75, title: `THE VERTICAL ONE`, onScreen: `x − 3 = 0` },
    { n: 60, afterSeg:  76, title: `YOU CANNOT DIVIDE BY ZERO`, onScreen: `x = 3 ✓ (boxed)` },
    { n: 61, afterSeg:  77, title: `AND THE HORIZONTAL ONE IS WHAT IS ADDED ON`, onScreen: `y = 2 ✓ (boxed)` },
    { n: 62, afterSeg:  79, title: `HERE IS WHY`, onScreen: `only the 2 is left` },
    { n: 63, afterSeg:  80, title: `SO THE CURVE FLATTENS TOWARDS Y = 2`, onScreen: `closer and closer, and never there` },
