    { n:  4, afterSeg:   4, title: `COUNT THE TERMS`, onScreen: `three terms → a trinomial` },
    { n:  5, afterSeg:   6, title: `BUT COMMON FACTOR FIRST`, onScreen: `so take out the 2` },
    { n:  6, afterSeg:   8, title: `WHAT IS LEFT INSIDE`, onScreen: `2(x² + 5x + 6)` },
    { n:  7, afterSeg:  10, title: `TWO NUMBERS: × TO 6, + TO 5`, onScreen: `x² + 5x + 6 = (x + 2)(x + 3)` },
    { n:  8, afterSeg:  11, title: `ANSWER`, onScreen: `2(x + 2)(x + 3) ✓ (boxed)` },
    { n:  9, afterSeg:  12, title: `WHY THE COMMON FACTOR WENT FIRST`, onScreen: `that is the whole reason it goes first` },
    { n: 10, afterSeg:  15, title: `COMPARE`, onScreen: `AN EXPRESSION x can be anything — it is only a rule · AN EQUATION there is an equals sign — one x fits` },
    { n: 11, afterSeg:  17, title: `LINEAR`, onScreen: `that is what the word means — nothing more` },
    { n: 12, afterSeg:  19, title: `ONE X → ONE ANSWER`, onScreen: `next episode the x is squared, and then there are two` },
    { n: 13, afterSeg:  20, title: `THINK OF IT AS A BALANCE`, onScreen: `THINK OF IT AS A BALANCE` },
    { n: 14, afterSeg:  21, title: `THE ONLY RULE TODAY`, onScreen: `add · subtract · multiply · divide — both sides, every time` },
    { n: 15, afterSeg:  24, title: `THE GOAL IS ALWAYS X ALONE ON ONE SIDE`, onScreen: `everything you do is aimed at that` },
    { n: 16, afterSeg:  25, title: `EXAMPLE 1`, onScreen: `3(2x − 5) = 4x + 7 · solve for x` },
    { n: 17, afterSeg:  27, title: `SO THE ORDER IS`, onScreen: `brackets first · x terms to one side · numbers to the other side · then divide` },
    { n: 18, afterSeg:  29, title: `BRACKETS FIRST`, onScreen: `6x − 15 = 4x + 7` },
    { n: 19, afterSeg:  32, title: `TAKE 4X OFF BOTH SIDES`, onScreen: `2x − 15 = 7` },
    { n: 20, afterSeg:  35, title: `ADD 15 TO BOTH SIDES`, onScreen: `2x = 22` },
    { n: 21, afterSeg:  37, title: `2X MEANS 2 × X — SO DIVIDE BOTH SIDES BY 2`, onScreen: `x = 11 ✓ (boxed)` },
    { n: 22, afterSeg:  40, title: `THE LEFT SIDE VS THE RIGHT SIDE`, onScreen: `51 = 51 ✓` },
    { n: 23, afterSeg:  42, title: `TEN SECONDS`, onScreen: `always test in the original question` },
    { n: 24, afterSeg:  43, title: `NSC PAPER 1 • NOVEMBER 2018`, onScreen: `NSC Mathematics P1 · November 2018 · Question 2.2 · 3 marks` },
    { n: 25, afterSeg:  44, title: `QUESTION 2.2`, onScreen: `Tₙ = −7n + 42 · Determine the value of n for which Tₙ = −140.` },
    { n: 26, afterSeg:  45, title: `SUBSTITUTE`, onScreen: `put −140 where Tₙ is` },
    { n: 27, afterSeg:  47, title: `NOW IT IS A LINEAR EQUATION IN N`, onScreen: `−7n + 42 = −140` },
    { n: 28, afterSeg:  49, title: `TAKE 42 OFF BOTH SIDES`, onScreen: `−7n = −140 − 42` },
    { n: 29, afterSeg:  51, title: `ALREADY BELOW ZERO, GOING FURTHER DOWN`, onScreen: `−7n = −182` },
    { n: 30, afterSeg:  54, title: `DIVIDE BOTH SIDES BY −7`, onScreen: `n = 182 divided by 7` },
    { n: 31, afterSeg:  55, title: `THE LONG DIVISION`, onScreen: `182 divided by 7 = 26` },
    { n: 32, afterSeg:  57, title: `ANSWER`, onScreen: `the 26th term is −140 ✓ (boxed)` },
    { n: 33, afterSeg:  59, title: `NOBODY ASKS THIS ON ITS OWN`, onScreen: `all three marks here were linear work` },
    { n: 34, afterSeg:  61, title: `EXAMPLE 3`, onScreen: `(x)/(2) + (x + 3)/(3) = 6 · where the marks actually go` },
    { n: 35, afterSeg:  64, title: `GET RID OF THE FRACTIONS`, onScreen: `2 and 3 both go into 6` },
    { n: 36, afterSeg:  66, title: `MULTIPLY BY 6 — THE FIRST TERM`, onScreen: `= 3x` },
    { n: 37, afterSeg:  67, title: `AND THE SECOND TERM`, onScreen: `= 2(x + 3)` },
    { n: 38, afterSeg:  68, title: `SO FAR SHE HAS`, onScreen: `3x + 2(x + 3) = 6` },
    { n: 39, afterSeg:  70, title: `LOOK AT THE RIGHT HAND SIDE`, onScreen: `red · the 6 was left alone ✗` },
    { n: 40, afterSeg:  71, title: `EVERY TERM MEANS EVERY TERM`, onScreen: `this is the most common mistake in the whole topic` },
    { n: 41, afterSeg:  74, title: `FINISH IT HER WAY`, onScreen: `red · x = 0` },
    { n: 42, afterSeg:  77, title: `TEST 0 IN THE QUESTION`, onScreen: `red · 1 ≠ 6 ✗` },
    { n: 43, afterSeg:  79, title: `GO BACK — MULTIPLY THE 6 AS WELL`, onScreen: `3x + 2(x + 3) = 36` },
    { n: 44, afterSeg:  82, title: `NOW OPEN THE BRACKET`, onScreen: `3x + 2x + 6 = 36` },
    { n: 45, afterSeg:  85, title: `TAKE 6 OFF, THEN DIVIDE BY 5`, onScreen: `x = 6 ✓ (boxed)` },
    { n: 46, afterSeg:  88, title: `TEST IT`, onScreen: `= 6 ✓ it matches ✓ (boxed)` },
    { n: 47, afterSeg:  89, title: `ONE EXTRA RULE — INEQUALITIES`, onScreen: `ONE EXTRA RULE — INEQUALITIES` },
    { n: 48, afterSeg:  90, title: `AN INEQUALITY`, onScreen: `greater than · less than · at least · at most` },
    { n: 49, afterSeg:  91, title: `INEQUALITIES`, onScreen: `−3x + 5 > 14 · solve for x` },
    { n: 50, afterSeg:  92, title: `TAKE 5 OFF BOTH SIDES`, onScreen: `−3x > 9` },
    { n: 51, afterSeg:  93, title: `THE ONE EXTRA RULE`, onScreen: `× or ÷ by a negative → the sign turns around` },
    { n: 52, afterSeg:  94, title: `DIVIDE BY −3 — AND TURN THE SIGN AROUND`, onScreen: `x < −3 ✓ (boxed)` },
    { n: 53, afterSeg:  97, title: `WHY? TEST X = −4 (BELOW −3)`, onScreen: `17 > 14 ✓` },
    { n: 54, afterSeg:  99, title: `NOW TEST X = 0 (ABOVE −3)`, onScreen: `red · 5 is not > 14 ✗` },
    { n: 55, afterSeg: 100, title: `THE ANSWERS REALLY ARE BELOW NEGATIVE THREE`, onScreen: `without the flip you would have had the whole thing backwards` },
    { n: 56, afterSeg: 101, title: `WHERE YOU LOSE MARKS`, onScreen: `WHERE YOU LOSE MARKS` },
    { n: 57, afterSeg: 102, title: `POINT 1 • BOTH SIDES, AND EVERY TERM`, onScreen: `Both sides, and every term — change one side only and it stops being true` },
    { n: 58, afterSeg: 103, title: `POINT 2 • FRACTIONS — MULTIPLY EVERY TERM`, onScreen: `Fractions — multiply every term — including the one that has no fraction under it` },
    { n: 59, afterSeg: 104, title: `POINT 3 • DIVIDING BY A NEGATIVE`, onScreen: `Dividing by a negative — equation → the answer changes sign · inequality → the sign turns around too` },
    { n: 60, afterSeg: 105, title: `REMEMBER`, onScreen: `REMEMBER` },
    { n: 61, afterSeg: 106, title: `POINT 1 • THE ORDER NEVER CHANGES`, onScreen: `The order never changes — brackets → fractions away → x to one side → numbers to the other → divide` },
    { n: 62, afterSeg: 107, title: `POINT 2 • TEST YOUR ANSWER IN THE ORIGINAL`, onScreen: `Test your answer in the original — one x, one answer — if it does not fit, it is wrong` },
    { n: 63, afterSeg: 108, title: `YOUR TURN`, onScreen: `(x − 1)/(4) + (x)/(2) = 5 · solve for x` },
    { n: 64, afterSeg: 109, title: `PAUSE AND TRY`, onScreen: `PAUSE AND TRY` },
    { n: 65, afterSeg: 112, title: `NEXT • QUADRATIC EQUATIONS`, onScreen: `NEXT — EPISODE 4: QUADRATIC EQUATIONS` },
