/**
 * Working It Out — Grade 12 Maths podcast — ElevenLabs audio generator
 * ----------------------------------------------------------------------------
 *   node --env-file=.env.local scripts/generate-maths-podcast-audio.mjs
 *   node --env-file=.env.local scripts/generate-maths-podcast-audio.mjs 1
 *
 * Same engine as the Business Brief series, with two additions:
 *   1. A line may carry `pause` (seconds) for a deliberate teaching silence.
 *   2. After stitching it writes timing CSVs beside the mp3:
 *        "<episode> - slide timings.csv"   slide -> timecode + hold
 *        "<episode> - line timings.csv"    every line -> timecode
 *
 * Output: podcasts/Working-It-Out/Episode 1 - Arithmetic Sequences.mp3
 * Clips:  podcasts/tmp/working-it-out/<episode-slug>/
 */

import fs from 'fs';
import path from 'path';
import https from 'https';
import { execSync } from 'child_process';

const ELEVENLABS_KEY = process.env.ELEVENLABS_API_KEY;
if (!ELEVENLABS_KEY) {
  console.error('Missing ELEVENLABS_API_KEY. Run with: node --env-file=.env.local scripts/generate-maths-podcast-audio.mjs');
  process.exit(1);
}

const VOICES = {
  NALEDI: 'ZF6FPAbjXT4488VcRRnw',  // updated voice
  MICHAEL: 'vDchjyOZZytffNeZXfZK', // Mike — Natural and Engaging Podcast Host
  AMELIA: 'IKne3meq5aSn9XLyUdCD',  // updated voice (narration)
};

const PRIMARY_MODEL = 'eleven_v3';
const FALLBACK_MODEL = 'eleven_turbo_v2_5';

// Embedded silent MP3 clips (base64) so natural pauses work even when the
// user's machine doesn't have ffmpeg installed — no external dependency needed.
const SILENCE_SHORT_B64 = ''; // ~0.35s, between dialogue lines
const SILENCE_LONG_B64 = ''; // ~0.9s, around title announcements

function voiceSettingsFor(modelId) {
  // Per ElevenLabs' own recommended defaults for eleven_v3 (style + speaker boost
  // included); fallback model just uses the classic two settings.
  return modelId === PRIMARY_MODEL
    ? { stability: 0.5, similarity_boost: 0.75, style: 0.0, use_speaker_boost: true }
    : { stability: 0.5, similarity_boost: 0.75 };
}

const ROOT = path.resolve('.');
const OUT_DIR = path.join(ROOT, 'podcasts', 'Working-It-Out');
const TMP_ROOT = path.join(ROOT, 'podcasts', 'tmp', 'working-it-out');

// ─────────────────────────────────────────────────────────────────────────
// EPISODES — each one is generated and stitched into its own separate file.
// (Episodes 1-2 populated for now — add more as they're ready.)
// ─────────────────────────────────────────────────────────────────────────
const EPISODES = [

{
  num: 1,
  file: 'Episode 1 - Arithmetic Sequences',
  segs: [
    { s: 'MICHAEL', t: `Hello, and welcome to Working It Out. I am Michael, your maths expert.` },
    { s: 'NALEDI', t: `And I am Naledi. I am here to ask Michael all the tough questions. Probably the same ones you are thinking.` },
    { s: 'MICHAEL', t: `Working It Out is where we go through every Grade Twelve maths topic, one step at a time, so that you are ready for your tests and your exams.` },
    { s: 'NALEDI', t: `Today we start a new topic. Sequences and series.` },
    { s: 'AMELIA', t: `Episode one. Arithmetic sequences.` },
    { s: 'MICHAEL', t: `In this episode you will learn three things. How to recognise the pattern. How to find the common difference. And how to use one formula to find any term you want.` },
    { s: 'NALEDI', t: `And we work through a real past paper question.` },
    { s: 'MICHAEL', t: `We do. So get your pen, your paper and your calculator ready.` },
    { s: 'MICHAEL', t: `Let us start with four easy numbers. Five. Ten. Fifteen. Twenty. What comes next?` },
    { s: 'NALEDI', t: `Twenty five. That one is easy. We are adding five each time.` },
    { s: 'MICHAEL', t: `Easy. But a Grade Twelve question will not stop there. It might ask you for the fiftieth term. Or the hundredth term. Or it might give you a number and ask you where that number sits in the sequence.` },
    { s: 'NALEDI', t: `And I do not want to add five a hundred times.` },
    { s: 'MICHAEL', t: `You do not need to. That is exactly what today gives you. A shortcut.` },
    { s: 'MICHAEL', t: `So let us see how the exam actually asks it. This is a real question. National Senior Certificate, Paper One, November two thousand and fourteen.` },
    { s: 'MICHAEL', t: `Here are the numbers. Two, plus nine, plus sixteen, and it carries on. Two hundred and fifty one numbers in total.` },
    { s: 'MICHAEL', t: `The exam asks two things. First, write down the fourth number. Then, calculate the two hundred and fifty first number.` },
    { s: 'NALEDI', t: `The fourth one is easy. But the two hundred and fifty first?` },
    { s: 'MICHAEL', t: `That is the whole point of today. Tell me how you would find it.` },
    { s: 'NALEDI', t: `Well, let me see the pattern first. Two to nine. That is plus seven.` },
    { s: 'NALEDI', t: `Nine to sixteen. Plus seven again.` },
    { s: 'NALEDI', t: `So I just keep adding seven. Two, nine, sixteen, twenty three. There is the fourth one. Twenty three.` },
    { s: 'MICHAEL', t: `Correct. Now do the same for the two hundred and fifty first.` },
    { s: 'NALEDI', t: `I would have to add seven, two hundred and fifty times. That will take the whole exam.` },
    { s: 'MICHAEL', t: `It will. So most learners try a shortcut. They say, start at two, and add seven, two hundred and fifty one times.` },
    { s: 'NALEDI', t: `That sounds right to me.` },
    { s: 'MICHAEL', t: `Test it on something small. Use your shortcut to find the second number. Two, plus two, times seven.` },
    { s: 'NALEDI', t: `Two plus fourteen. That is sixteen. … But the second number is nine, not sixteen.` },
    { s: 'MICHAEL', t: `Exactly. You added seven one time too many. That single extra step is the most common mistake in this whole topic. Let us fix it.` },
    { s: 'MICHAEL', t: `First the names. When you add the same amount every time, that is called an arithmetic sequence.` },
    { s: 'MICHAEL', t: `A sequence is a list of numbers in order. Each number is called a term.` },
    { s: 'NALEDI', t: `So two is the first term. Nine is the second term.` },
    { s: 'MICHAEL', t: `Yes. And that seven you keep adding has an exam name. It is called the common difference.` },
    { s: 'MICHAEL', t: `Common means every step shares it. Difference means you find it by subtracting.` },
    { s: 'NALEDI', t: `So nine minus two gives seven.` },
    { s: 'MICHAEL', t: `Later term, minus earlier term. Always in that order. And check it twice.` },
    { s: 'NALEDI', t: `Sixteen minus nine is also seven. Same answer.` },
    { s: 'MICHAEL', t: `Now you know it really is arithmetic. If those two answers were different, everything we do next would be wrong.` },
    { s: 'MICHAEL', t: `Let us build the rule together. Do not memorise. Just count with me.` },
    { s: 'MICHAEL', t: `We start at two. That is the first term.` },
    { s: 'MICHAEL', t: `To reach the second term, how many times do you add seven?` },
    { s: 'NALEDI', t: `One time. Two plus seven is nine.` },
    { s: 'MICHAEL', t: `To reach the third term?` },
    { s: 'NALEDI', t: `Two times. That gives sixteen.` },
    { s: 'MICHAEL', t: `And the fourth?` },
    { s: 'NALEDI', t: `Three times. … Oh. The number of steps is always one less than the term number.` },
    { s: 'MICHAEL', t: `There it is. That is the answer to your shortcut problem. To reach term two hundred and fifty one, you take two hundred and fifty steps. Not two hundred and fifty one.` },
    { s: 'NALEDI', t: `Because the first term is already there before you take any step.` },
    { s: 'MICHAEL', t: `That is exactly why. Say that sentence again in the exam and you will never get it wrong.` },
    { s: 'MICHAEL', t: `So the rule is this. The enth term equals the first term, plus n minus one, times the common difference.` },
    { s: 'MICHAEL', t: `In the exam, a means the first term, and d means the common difference.` },
    { s: 'NALEDI', t: `So the n minus one is not a trick. It is counting the steps.` },
    { s: 'MICHAEL', t: `It is only counting the steps. Nothing more.` },
    { s: 'MICHAEL', t: `Back to the paper. Question two point one says, write down the fourth term. When the exam says write down, it wants the answer only. No working. One mark.` },
    { s: 'NALEDI', t: `Twenty three. I already counted it.` },
    { s: 'MICHAEL', t: `Good. Do not waste time there. Now question two point two says calculate. When it says calculate, you must show your working.` },
    { s: 'MICHAEL', t: `Write down what you know first. Every time.` },
    { s: 'NALEDI', t: `The first term is two. So a is two. The common difference is seven. So d is seven. And n is two hundred and fifty one.` },
    { s: 'MICHAEL', t: `Put them into the rule. Say it as you write it.` },
    { s: 'NALEDI', t: `The enth term equals two, plus n minus one, times seven.` },
    { s: 'NALEDI', t: `So that is two, plus two hundred and fifty one minus one, times seven.` },
    { s: 'MICHAEL', t: `And two hundred and fifty one minus one is?` },
    { s: 'NALEDI', t: `Two hundred and fifty. Times seven is one thousand seven hundred and fifty.` },
    { s: 'NALEDI', t: `Plus the two. One thousand seven hundred and fifty two.` },
    { s: 'MICHAEL', t: `That is the answer. Three marks. Now check the rule works on a small term. Put n equals two.` },
    { s: 'NALEDI', t: `Two, plus two minus one, times seven. That is two plus seven. Nine. And nine is the second term.` },
    { s: 'MICHAEL', t: `Ten seconds of checking. It tells you the whole answer is safe.` },
    { s: 'NALEDI', t: `And my shortcut would have given one thousand seven hundred and fifty nine. Seven too much.` },
    { s: 'MICHAEL', t: `One extra step. One lost mark.` },
    { s: 'MICHAEL', t: `Four things the markers watch for.` },
    { s: 'MICHAEL', t: `Number one. Use n minus one, not n. The first term needs no steps.` },
    { s: 'MICHAEL', t: `Number two. Check the common difference twice. Second term minus first. Then third term minus second. If they do not match, it is not an arithmetic sequence, and this rule will not work.` },
    { s: 'MICHAEL', t: `Number three. Always take the later term minus the earlier term. If the numbers go down, your common difference is negative. Keep the minus sign.` },
    { s: 'MICHAEL', t: `Number four. Read the command word. Write down means answer only. Calculate means show your working. If it says calculate and you write one number, you lose the method marks even when the number is right.` },
    { s: 'MICHAEL', t: `Three things to remember.` },
    { s: 'MICHAEL', t: `One. An arithmetic sequence adds the same amount each time. That amount is the common difference.` },
    { s: 'MICHAEL', t: `Two. The rule is the first term, plus n minus one, times the common difference.` },
    { s: 'MICHAEL', t: `Three. The n minus one is counting steps. And test your rule with a small term before you trust it.` },
    { s: 'MICHAEL', t: `Here is your question. Same sequence. Two, nine, sixteen, and so on. Which term of this sequence is equal to seven hundred and two?` },
    { s: 'MICHAEL', t: `Pause and try it. I will wait.`, pause: 3.0 },
    { s: 'MICHAEL', t: `I will give you the answer at the start of the next episode. And in that episode, everything changes. We stop adding the same amount, and we start multiplying by the same amount.` },
    { s: 'NALEDI', t: `Multiplying instead of adding. That will grow much faster.` },
    { s: 'MICHAEL', t: `Much faster. It is called a geometric sequence. See you there.` },
    { s: 'AMELIA', t: `That was episode one. Arithmetic sequences. Next, episode two. Geometric sequences.` },
  ],
