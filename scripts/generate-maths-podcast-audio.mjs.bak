// ─────────────────────────────────────────────────────────────────────────

function stripTags(text) {
  return text.replace(/\[[a-zA-Z ]+\]\s*/g, '').trim();
}

function pad(n, len = 4) { return String(n).padStart(len, '0'); }

function requestTTS(text, voiceId, modelId) {
  return new Promise((resolve, reject) => {
    const body = JSON.stringify({
      text,
      model_id: modelId,
      voice_settings: voiceSettingsFor(modelId),
    });
    const req = https.request({
      hostname: 'api.elevenlabs.io',
      path: `/v1/text-to-speech/${voiceId}`,
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'xi-api-key': ELEVENLABS_KEY,
        'Accept': 'audio/mpeg',
      },
    }, (res) => {
      const chunks = [];
      res.on('data', c => chunks.push(c));
      res.on('end', () => {
        if (res.statusCode !== 200) {
          reject(new Error(`${res.statusCode}: ${Buffer.concat(chunks)}`));
        } else {
          resolve(Buffer.concat(chunks));
        }
      });
    });
    req.on('error', reject);
    req.write(body);
    req.end();
  });
}

async function generateAudio(text, voiceId, outputPath) {
  try {
    const buf = await requestTTS(text, voiceId, PRIMARY_MODEL);
    fs.writeFileSync(outputPath, buf);
    return 'v3';
  } catch (e) {
    console.warn(`  ! ${PRIMARY_MODEL} failed (${e.message.slice(0, 300)}) — retrying with ${FALLBACK_MODEL}`);
    const buf = await requestTTS(stripTags(text), voiceId, FALLBACK_MODEL);
    fs.writeFileSync(outputPath, buf);
    return 'fallback';
  }
}

async function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

function hasFfmpeg() {
  try { execSync('ffmpeg -version', { stdio: 'ignore' }); return true; }
  catch { return false; }
}

function esc(p) { return p.replace(/'/g, "'\\''"); }

function probeDuration(file) {
  try {
    return parseFloat(execSync(`ffprobe -v quiet -show_entries format=duration -of csv=p=0 "${file}"`).toString().trim());
  } catch { return NaN; }
}

function silenceOf(seconds, dir) {
  const f = path.join(dir, `_silence_${String(seconds).replace('.', '_')}.mp3`);
  if (!fs.existsSync(f)) {
    execSync(`ffmpeg -y -f lavfi -i anullsrc=r=44100:cl=mono -t ${seconds} -q:a 9 "${f}"`, { stdio: 'ignore' });
  }
  return f;
}

function timecode(sec) {
  const m = Math.floor(sec / 60), s = sec - m * 60;
  return `${String(m).padStart(2, '0')}:${s.toFixed(3).padStart(6, '0')}`;
}

function csvCell(v) { return `"${String(v).replace(/"/g, '""')}"`; }

function slugifyFolder(name) {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

function writeTimings(ep, files, starts, total) {
  if (!starts.some(v => Number.isFinite(v))) {
    console.warn('  ⚠ ffprobe unavailable — timing CSVs skipped.');
    return;
  }

  // mm:ss.t  ·  and the same stamp as mm-ss-t for filenames
  const stamp = (sec, sep) => {
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    const t = Math.floor((sec % 1) * 10);
    return sep === ':' ? `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}.${t}`
                       : `${String(m).padStart(2,'0')}-${String(s).padStart(2,'0')}-${t}`;
  };
  const slug = (s) => s.toUpperCase().replace(/[^A-Z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 46);

  // ---- line timings (for finding a fluffed line) ----
  const lineRows = [['line', 'speaker', 'start', 'seconds', 'text'].join(',')];
  files.forEach((f, i) => {
    if (!Number.isFinite(starts[f.seg])) return;
    const next = Number.isFinite(starts[files[i + 1]?.seg]) ? starts[files[i + 1].seg] : total;
    lineRows.push([f.seg, ep.segs[f.seg].s, stamp(starts[f.seg], ':'),
                   (next - starts[f.seg]).toFixed(3), csvCell(ep.segs[f.seg].t)].join(','));
  });
  fs.writeFileSync(path.join(OUT_DIR, `${ep.file} - line timings.csv`), lineRows.join('\n') + '\n');

  if (!ep.slides?.length) return;

  // ---- slide timings: start, end, filename, title ----
  // per-episode folders so episodes never overwrite each other's slides
  const epTag  = `ep${String(ep.num).padStart(2, '0')}`;
  const nested = path.join(OUT_DIR, 'slides', epTag);
  const srcDir = fs.existsSync(nested) ? nested : path.join(OUT_DIR, 'slides');
  const outDir = path.join(OUT_DIR, 'slides-timed', epTag);
  fs.mkdirSync(outDir, { recursive: true });

  const rows = [['start', 'end', 'filename', 'title'].join(',')];
  ep.slides.forEach((s, i) => {
    const start = i === 0 ? 0 : (starts[s.afterSeg] ?? 0);
    const nextSlide = ep.slides[i + 1];
    const end = nextSlide ? (starts[nextSlide.afterSeg] ?? total) : total;

    const nn = String(s.n).padStart(2, '0');
    const filename = `${nn}_${stamp(start, '-')}_${slug(s.title)}.png`;

    // copy the rendered slide to a name that carries its cue time
    const from = path.join(srcDir, `slide-${nn}.png`);
    if (fs.existsSync(from)) fs.copyFileSync(from, path.join(outDir, filename));

    rows.push([stamp(start, ':'), stamp(end, ':'), filename, csvCell(s.title)].join(','));
  });

  fs.writeFileSync(path.join(OUT_DIR, `${ep.file} - slide timings.csv`), rows.join('\n') + '\n');
  console.log(`  ⏱  Timings: ${ep.file} - slide timings.csv`);
  console.log(`  🖼  Timed slides: ${outDir}`);
}

async function generateEpisode(ep, ffmpegAvailable, silenceShort, silenceLong) {
  const epDir = path.join(TMP_ROOT, slugifyFolder(ep.file));
  fs.mkdirSync(epDir, { recursive: true });

  const files = [];
  let usedFallback = 0;

  for (let i = 0; i < ep.segs.length; i++) {
    const seg = ep.segs[i];
    const voiceId = VOICES[seg.s];
    const fname = `${pad(i)}_${seg.s.toLowerCase()}.mp3`;
    const outPath = path.join(epDir, fname);
    files.push({ path: outPath, isTitle: seg.s === 'AMELIA', pause: seg.pause, seg: i });

    if (fs.existsSync(outPath) && fs.statSync(outPath).size > 0) {
      console.log(`  [${pad(i)}] ${seg.s} — already exists, skipping`);
      continue;
    }

    console.log(`  [${pad(i)}] ${seg.s}: ${seg.t.slice(0, 60)}${seg.t.length > 60 ? '...' : ''}`);
    try {
      const mode = await generateAudio(seg.t, voiceId, outPath);
      if (mode === 'fallback') usedFallback++;
    } catch (e) {
      console.error(`    ✗ FAILED: ${e.message.slice(0, 200)}`);
    }
    await sleep(400);
  }

  const missing = files.filter(f => !fs.existsSync(f.path) || fs.statSync(f.path).size === 0);
  if (missing.length) {
    console.warn(`  ⚠ ${missing.length} segment(s) failed in "${ep.file}". Re-run the script to retry just those.`);
  }
  if (usedFallback) {
    console.warn(`  ⚠ ${usedFallback} segment(s) in "${ep.file}" used the ${FALLBACK_MODEL} fallback.`);
  }

  const outPath = path.join(OUT_DIR, `${ep.file}.mp3`);

  if (ffmpegAvailable) {
    const listPath = path.join(epDir, '_concat_list.txt');
    const lines = [];
    const starts = [];
    let cursor = 0;

    for (const f of files) {
      if (!fs.existsSync(f.path)) continue;
      if (f.isTitle) { lines.push(`file '${esc(silenceLong)}'`); cursor += 0.9; }

      starts[f.seg] = cursor;
      lines.push(`file '${esc(f.path)}'`);
      const d = probeDuration(f.path);
      cursor += Number.isFinite(d) ? d : 0;

      const gapSecs = f.pause ?? (f.isTitle ? 0.9 : 0.35);
      const gapFile = f.pause ? silenceOf(f.pause, epDir) : (f.isTitle ? silenceLong : silenceShort);
      lines.push(`file '${esc(gapFile)}'`);
      cursor += gapSecs;
    }
    fs.writeFileSync(listPath, lines.join('\n'));
    execSync(`ffmpeg -y -f concat -safe 0 -i "${listPath}" -c:a libmp3lame -q:a 2 "${outPath}"`, { stdio: 'ignore' });
    console.log(`  ✅ Saved: ${outPath}`);

    writeTimings(ep, files, starts, cursor);
  } else {
    const shortSilence = Buffer.from(SILENCE_SHORT_B64, 'base64');
    const longSilence = Buffer.from(SILENCE_LONG_B64, 'base64');
    const out = fs.createWriteStream(outPath);
    for (const f of files) {
      if (!fs.existsSync(f.path)) continue;
      if (f.isTitle) out.write(longSilence);
      out.write(fs.readFileSync(f.path));
      out.write(f.isTitle ? longSilence : shortSilence);
    }
    out.end();
    console.log(`  ✅ Saved (raw concat with natural pauses): ${outPath}`);
  }
}

async function main() {
  fs.mkdirSync(OUT_DIR, { recursive: true });
  fs.mkdirSync(TMP_ROOT, { recursive: true });

  const requested = process.argv.slice(2).map(Number).filter(n => Number.isInteger(n) && n >= 1);
  const episodesToRun = requested.length ? EPISODES.filter(ep => requested.includes(ep.num)) : EPISODES;

  // --keep: reuse the cached clips instead of re-recording (free).
  // Use it when only slides, titles or timings changed.
  const keep = process.argv.slice(2).includes('--keep');

  if (requested.length && keep) {
    console.log(`Re-stitching only episode(s): ${episodesToRun.map(e => e.num).join(', ')} — using cached clips, nothing will be re-recorded.\n`);
  }

  if (requested.length && !keep) {
    console.log(`Re-recording only episode(s): ${episodesToRun.map(e => e.num).join(', ')}\n`);
    for (const ep of episodesToRun) {
      const epDir = path.join(TMP_ROOT, slugifyFolder(ep.file));
      if (fs.existsSync(epDir)) fs.rmSync(epDir, { recursive: true, force: true });
      const outPath = path.join(OUT_DIR, `${ep.file}.mp3`);
      if (fs.existsSync(outPath)) fs.rmSync(outPath, { force: true });
    }
  }

  const ffmpegAvailable = hasFfmpeg();
  let silenceShort, silenceLong;
  if (ffmpegAvailable) {
    silenceShort = path.join(TMP_ROOT, '_silence_short.mp3');
    silenceLong = path.join(TMP_ROOT, '_silence_long.mp3');
    if (!fs.existsSync(silenceShort)) {
      execSync(`ffmpeg -y -f lavfi -i anullsrc=r=44100:cl=mono -t 0.35 -q:a 9 "${silenceShort}"`, { stdio: 'ignore' });
    }
    if (!fs.existsSync(silenceLong)) {
      execSync(`ffmpeg -y -f lavfi -i anullsrc=r=44100:cl=mono -t 0.9 -q:a 9 "${silenceLong}"`, { stdio: 'ignore' });
    }
  } else {
    console.warn('⚠ ffmpeg not found — episodes will be raw-concatenated using embedded silence for pauses. Install ffmpeg for cleaner pacing.\n');
  }

  console.log(`The Business Brief — Creative Thinking & Problem Solving — running ${episodesToRun.length} of ${EPISODES.length} episode(s)\n`);

  for (const ep of episodesToRun) {
    console.log(`\n▶ ${ep.file}`);
    await generateEpisode(ep, ffmpegAvailable, silenceShort, silenceLong);
  }

  console.log(`\n✅ Done. Check ${OUT_DIR} for the final files.`);
}

main().catch(e => { console.error(e); process.exit(1); });
