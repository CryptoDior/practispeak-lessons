  ],
  slides: [
    { n:  1, afterSeg:   0, title: `REVISION 1 • EPISODE 2 • FACTORISING`, onScreen: `EPISODE 2 — FACTORISING` },
    { n:  2, afterSeg:   1, title: `LAST TIME WE TOOK THE BRACKETS AWAY`, onScreen: `today we put them back` },
